def _mini_yaml(text):
    """Enough YAML for a flat profile: scalars, inline [a, b] lists, and `- item` blocks.
    pyyaml is used when importable; this exists so `rfp` still runs where it isn't."""
    out, key = {}, None
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].rstrip() if not raw.strip().startswith("#") else ""
        if not line.strip():
            continue
        if line.lstrip().startswith("- ") and key is not None:
            out.setdefault(key, [])
            if isinstance(out[key], list):
                out[key].append(_scalar(line.lstrip()[2:]))
            continue
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*:\s*(.*)$", line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if val == "":
            out[key] = []
        elif val.startswith("[") and val.endswith("]"):
            inner = val[1:-1].strip()
            out[key] = [_scalar(x) for x in inner.split(",")] if inner else []
        else:
            out[key] = _scalar(val)
    return out


def _scalar(s):
    s = s.strip().strip('"').strip("'")
    if s.lower() in ("null", "none", "~", ""):
        return None
    if s.lower() == "true":
        return True
    if s.lower() == "false":
        return False
    if re.fullmatch(r"-?\d+", s):
        return int(s)
    if re.fullmatch(r"-?\d+\.\d+", s):
        return float(s)
    return s


def load_profile(path=None, enabled=True):
    p = Path(path) if path else PROFILE_MD
    prof = dict(PROFILE_DEFAULTS)
    prof["_source"] = str(p)
    prof["_enabled"] = enabled
    if not enabled or not p.exists():
        prof["_source"] = str(p) + (" (missing)" if not p.exists() else " (disabled)")
        return prof
    text = p.read_text(encoding="utf-8", errors="replace")
    blocks = re.findall(r"```(?:ya?ml)?\s*\n(.*?)```", text, re.S)
    body = blocks[0] if blocks else text
    data = None
    try:
        import yaml
        data = yaml.safe_load(body)
    except Exception:
        data = None
    if not isinstance(data, dict):
        data = _mini_yaml(body)
    for k, v in (data or {}).items():
        if k in PROFILE_DEFAULTS:
            prof[k] = v
    if isinstance(prof.get("abc_band"), (int, float)):
        prof["abc_band"] = [0, prof["abc_band"]]
    for k in ("categories", "regions", "never"):
        v = prof.get(k) or []
        prof[k] = [str(x).strip() for x in (v if isinstance(v, list) else [v]) if x is not None]
    prof["results"] = int(prof.get("results") or 10)
    prof["min_days_to_close"] = int(prof.get("min_days_to_close") or 0)
    return prof


def profile_provinces(prof):
    """Expand profile `regions` (which legitimately mixes region names and province names) into a
    province set plus its adjacency ring."""
    want, adj = set(), set()
    for entry in prof.get("regions") or []:
        e = norm_ws(entry)
        el = e.lower()
        matched = None
        for rname, provs in REGIONS.items():
            if el == rname.lower() or el.replace("region ", "") == rname.lower().replace(
                    "region ", ""):
                matched = provs
                break
        if matched:
            want.update(p.lower() for p in matched)
        else:
            want.add(canon_province(e).lower() if canon_province(e) else el)
    for p in list(want):
        adj.update(_ADJ.get(p, set()))
    return want, adj - want


