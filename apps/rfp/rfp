def cmd_facets(args):
    """~300 tokens of orientation over 22,068 notices.  This is what replaces 'the model can see
    everything' -- the corpus is ~1.55M tokens of listing rows and does not fit in any window."""
    prof = load_profile(args.profile, enabled=not args.no_profile)
    con = connect()
    s = schema(con)
    args.results = 1
    rows, notes, relaxed = run_query(con, args.query, args, prof, pool=args.pool)
    if not rows:
        print(f"0 notices match q={args.query!r}")
        for n in notes:
            print(f"note: {n}")
        return 0

    def tally(keyfn):
        c = {}
        for r in rows:
            for k in keyfn(r):
                c[k] = c.get(k, 0) + 1
        return sorted(c.items(), key=lambda kv: (-kv[1], kv[0]))

    def line(label, pairs, top):
        shown = pairs[:top]
        rest = sum(v for _, v in pairs[top:])
        body = " ".join(f"{k}:{v}" for k, v in shown)
        if rest:
            body += f" +{len(pairs)-top}more:{rest}"
        return f"{label} {body}"

    dbands = {"<=2d": 0, "3-6d": 0, "7-13d": 0, "14-29d": 0, "30d+": 0, "no-date": 0,
              "closed": 0}
    for r in rows:
        d = days_to(r["closing_at"])
        k = ("no-date" if d is None else "closed" if d < 0 else "<=2d" if d <= 2 else
             "3-6d" if d <= 6 else "7-13d" if d <= 13 else "14-29d" if d <= 29 else "30d+")
        dbands[k] += 1
    val = sum(r["abc"] or 0 for r in rows)
    capped = " (pool capped -- raise --pool for exact counts)" if len(rows) >= args.pool else ""
    print(f"{len(rows)} notices{capped}  value {peso(val)}  q={args.query!r}")
    print(line("work_type", tally(lambda r: [r["work_type"] or "untagged"]), 8))
    def prov_keys(r):
        ps = [p.strip() for p in (r["provinces"] or "").split(",") if p.strip()]
        if ps:
            return ps
        g = agency_province(r["agency"])       # '~' = inferred from the agency name, not stated
        return [f"~{g}"] if g else ["(no location)"]
    print(line("province ", tally(prov_keys), 12))
    print(line("mode     ", tally(lambda r: [r["mode_family"] or "?"]), 8))
    print(line("abc      ", tally(lambda r: [r["abc_band"] or abc_band(r["abc"])]), 8))
    print(line("class    ", tally(lambda r: [(r["classification"] or "?")[:22]]), 5)
          + "   <- self-declared by the agency; wrong often enough to matter")
    print(line("days     ", sorted(dbands.items(), key=lambda kv: -kv[1]), 7))
    print(line("source   ", tally(lambda r: [r["source"] or "?"]), 3))
    print(line("agency   ", tally(lambda r: [abbrev_agency(r["agency"], 26)]), 6))
    for n in notes:
        print(f"note: {n}")
    return 0


