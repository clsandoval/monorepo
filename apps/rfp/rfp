    def t_lot_journey():
        """The design doc's named example, end to end: notice 54278 is P360K made of six P60K
        lots, and a bidder filtering ABC <= P100K must not merely find it, it must rank as a fit.
        This is the regression that caught the inverted-band bug in effective_profile()."""
        row = con.execute(
            f"select id from {s['base']} where abc_lot_max is not null and abc_lot_max < 100000 "
            f"and abc > 150000 and {expr(s,'enriched_at')} is not null limit 1").fetchone() \
            if "abc_lot_max" in s["cols"] else None
        if not row:
            return
        nid = row["id"]
        a = _args_for_search(results=400, abc_max=100000, include_closed=True, no_profile=False)
        a.profile, a.min_days, a.band = None, None, False
        eff, _told = effective_profile(a, load_profile(enabled=True))
        assert eff["abc_band"] == [0.0, 100000], eff["abc_band"]
        rows_, _, _ = run_query(con, None, a, eff, pool=100000)
        cand = {r["id"]: r for r in rows_}
        assert nid in cand, f"notice {nid} not even in the candidate pool at abc<=100K"
        r = cand[nid]
        fit, notes_ = profile_fit(r, eff, *profile_provinces(eff))
        assert notes_ and "lot fits" in notes_[0], (
            f"notice {nid} is {peso(r['abc'])} of {peso(r['abc_lot_max'])} lots at a "
            f"{eff['abc_band']} band, but its first annotation is {notes_} -- the money note "
            f"must lead, and it must say the lot fits, not that the total is a stretch")
        # Isolate the ABC dimension: the same notice with its lot columns blanked must score
        # STRICTLY worse, which is what proves the lot rule (and not something else) did the work.
        blind = _R({k: (None if k in ("abc_lot_min", "abc_lot_max") else r[k]) for k in r.keys()})
        fit_blind, notes_blind = profile_fit(blind, eff, *profile_provinces(eff))
        assert fit > fit_blind and any("stretch" in x for x in notes_blind), (
            fit, notes_, fit_blind, notes_blind)
        selfcheck.lot = (f"notice {nid}: fit {fit} {notes_[0]!r} vs {fit_blind} without lot "
                         f"columns ({notes_blind[0]!r})")
