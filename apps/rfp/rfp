def days_str(closing_at):
    d = days_to(closing_at)
    if d is None:
        return "no-date"
    if d < 0:
        return "CLOSED"
    if d == 0:
        return "TODAY"
    return f"{d}d"


def lots_str(row):
    lmin, lmax = row["abc_lot_min"], row["abc_lot_max"]
    if lmin is None or lmax is None or row["abc"] is None:
        return None
    if abs(lmin - row["abc"]) < 1 and abs(lmax - row["abc"]) < 1:
        return None
    if abs(lmin - lmax) < 1:
        n = round(row["abc"] / lmin) if lmin else 0
        return f"lots {n}x{peso(lmin)}" if n > 1 else f"lot {peso(lmin)}"
    return f"lots {peso(lmin)}-{peso(lmax)}"


def clean_snip(snip):
    """Snippets come off the line-items column full of UNSPSC codes and duplicated phrases
    ('1 43231511 Expert **system** **software** Expert **system** **software** 1'), which is
    ~12 tokens of nothing.  Strip the codes and collapse the repeats."""
    if not snip:
        return None
    s = re.sub(r"\s*\|\s*", " ", norm_ws(snip))
    s = re.sub(r"\b\d{5,}\b", "", s)                  # UNSPSC / PR numbers
    s = re.sub(r"(?<![\w*])\d+(?:\.\d+)?(?![\w*])", "", s)   # bare quantities
    words = s.split()
    out = []
    for w in words:                                    # collapse immediate repeats, incl. runs
        if out and w.lower() == out[-1].lower():
            continue
        out.append(w)
    for n in (4, 3, 2):                                # collapse a repeated n-gram once
        i = 0
        while i + 2 * n <= len(out):
            if [x.lower() for x in out[i:i + n]] == [x.lower() for x in out[i + n:i + 2 * n]]:
                del out[i + n:i + 2 * n]
            else:
                i += 1
    s = norm_ws(" ".join(out)).strip(" -,;:")
    return s or None


def hoist_common_notes(hits):
    """A profile annotation that fires on nearly every hit is a property of the corpus, not of
    the notice.  'untagged' on 40 rows costs ~120 tokens and says one thing, so it moves to a
    single footer line.  Annotations that differ per hit (stretch, adjacent, tight) never
    qualify and stay where the reader needs them."""
    if len(hits) < 4:
        return hits, []
    counts = {}
    for _, _, notes, _ in hits:
        for n in notes:
            counts[n] = counts.get(n, 0) + 1
    common = {n for n, c in counts.items() if c >= max(4, int(0.6 * len(hits)))}
    if not common:
        return hits, []
    out = [(sc, fit, [n for n in notes if n not in common], r) for sc, fit, notes, r in hits]
    return out, [f"all/most hits: {n}" for n in sorted(common)]


def attach_doc_evidence(con, hits, match_expr):
    """Fill in the attachment snippet + filename for the hits that are about to be printed.

    Phase two of doc_match's two-phase design: snippets are produced for the <=40 winning blobs,
    never for the thousands that merely matched."""
    if not match_expr or not hits:
        return
    blobs = [r["doc_blob"] for _, _, _, r in hits if r.get("doc_blob")]
    if not blobs:
        return
    ev = doc_snippets(con, blobs, match_expr)
    names = doc_names(con, [b for b in blobs if b not in ev])
    for _, _, _, r in hits:
        b = r.get("doc_blob")
        if not b:
            continue
        e = ev.get(b)
        r["doc_snip"] = (e or {}).get("snip") or ""
        r["doc_name"] = ((e or {}).get("name") or names.get(b, "") or "").split(",")[0].strip()


def render_hits(hits, prof, budget=BUDGET_MEAN, show_snip=True):
    hits, footer = hoist_common_notes(hits)
    return [format_hit(*h, prof, budget=budget, show_snip=show_snip) for h in hits], footer


def format_hit(score, fit, notes, row, prof, budget=BUDGET_MEAN, show_snip=True):
    """Four lines max, trimmed to fit `budget` estimated tokens: snippet goes first, then the
    title is shortened.  Fields the design doc requires are never dropped: ABC, days-to-close,
    province, mode, fit, title, agency, snippet."""
    abcs = peso(row["abc"]) if row["abc"] is not None else "abc?"
    prov = row["province"]
    if not prov:
        g = agency_province(row["agency"])
        prov = f"~{g}" if g else "loc?"     # '~' = inferred from the agency name, not stated
    mode = MODE_SHORT.get(row["mode_family"] or "", (row["mode_family"] or "?")[:4])
    # Provenance: WHERE this hit matched, as a '+'-joined code list.  ~3 tokens, and without it
    # the reader cannot tell an exact title match from a word buried in an annex -- which is the
    # difference between a lead and a coincidence.
    m = row.get("matched") or []
    head = (f"[{row['id']}] {abcs} {days_str(row['closing_at'])} {prov} {mode} fit{fit:.2f}"
            + (" @" + "+".join(m) if m else ""))
    notes = [n if len(n) <= 44 else n[:43] + "…" for n in notes]
    bits = [abbrev_agency(row["agency"])]
    if row["work_type"]:
        bits.append(row["work_type"])
    lot = lots_str(row)
    if lot:
        bits.append(lot)
    l3 = "  " + " | ".join(bits)
    title = norm_ws(row["title"]) or "(no title)"
    snip = clean_snip(row["snip"]) if show_snip else None
    if snip:
        plain = re.sub(r"\*\*", "", snip).lower()
        # A snippet that only repeats the title earns nothing; spend those tokens on scope.
        if plain and plain.strip("… ") in title.lower():
            snip = None
    # An attachment match earns the evidence line ahead of the notice text: it is the only
    # channel whose hit the reader cannot otherwise verify, and naming the file is what makes it
    # checkable ('BOQ.pdf' vs 'Annex D').
    if show_snip and "att" in m and row.get("doc_snip"):
        nm = (row.get("doc_name") or "").strip()
        if len(nm) > 26:
            nm = nm[:25] + "…"
        snip = (f"{nm}: " if nm else "att: ") + clean_snip(row["doc_snip"])
    if not snip and row["scope"]:
        snip = norm_ws(row["scope"])

    def render(t, sn, nmax):
        l1 = head + (" (" + "; ".join(notes[:nmax]) + ")" if notes and nmax else "")
        out = [l1, "  " + t, l3]
        if sn:
            out.append("  " + sn)
        return "\n".join(out)

    # The order of sacrifice, cheapest first: snippet length, then title length, then the SECOND
    # profile annotation.  The first annotation is never dropped -- a demoted hit whose reason is
    # invisible is worse than no hit, because the reader cannot tell a stretch from a mismatch.
    ladder = ((100, 78, 2), (92, 64, 2), (84, 56, 1), (80, 0, 1), (68, 0, 1))
    # An attachment-ONLY hit is the exception.  Its title and description do not contain the
    # query at all, so dropping the snippet leaves a row whose presence in the results looks
    # arbitrary -- the reader sees '@att' and no evidence.  For those, sacrifice the title and
    # the second annotation first and keep a (shorter) evidence line to the end.
    if m == ["att"] and snip:
        ladder = ((88, 70, 1), (76, 62, 1), (64, 54, 1), (52, 46, 1), (46, 40, 1))
    for tmax, smax, nmax in ladder:
        t = title if len(title) <= tmax else title[:tmax - 1].rstrip() + "…"
        sn = None
        if smax and snip:
            sn = snip if len(snip) <= smax else snip[:smax - 1].rstrip() + "…"
        text = render(t, sn, nmax)
        if est_tokens(text) <= budget:
            return text
    return render(title[:66] + "…", None, 1)


def effective_profile(args, prof):
    """An explicit filter must also move the RANKING, not just the WHERE clause.

    `--province Cavite` keeps location-null notices on purpose (8.7% of the corpus, and dropping
    them is the omission bug).  But if those nulls then score the same as real Cavite hits, BM25
    decides the order and the user asked for Cavite and got Davao.  So an explicit --province /
    --abc-* / --work-type overrides the corresponding profile field for scoring, and the
    profile's other fields keep applying underneath.
    """
    eff, told = dict(prof), []
    if not prof.get("_enabled"):
        return eff, told
    if args.province:
        eff["regions"] = [p.strip() for a in args.province for p in str(a).split(",")
                          if p.strip()]
        told.append(f"ranking geography from --province {eff['regions']} (overrides profile)")
    if args.abc_min is not None or args.abc_max is not None:
        # The ranking band must be EXACTLY the filter band.  Mixing a flag with the profile's
        # other side produced an inverted band ('P200K-P100K' from --abc-max 100000 against a
        # [200K, 5M] profile), which then scored notice 54278 -- P360K of six P60K lots -- as
        # 'stretch: P360K vs your P100K band' at fit 0.20, i.e. the exact notice the design doc
        # names as the thing that must rank UP.  One side given means the other is open.
        lo = args.abc_min if args.abc_min is not None else 0.0
        hi = args.abc_max if args.abc_max is not None else float(10 ** 13)
        eff["abc_band"] = [lo, hi]
        told.append(f"ranking ABC band from flags: {peso(lo)}-"
                    f"{'open' if args.abc_max is None else peso(hi)}")
    if args.work_type:
        eff["categories"] = [w.strip() for a in args.work_type for w in str(a).split(",")
                             if w.strip()]
    if args.min_days is not None:
        eff["min_days_to_close"] = args.min_days
    return eff, told


def cmd_search(args):
    prof = load_profile(args.profile, enabled=not args.no_profile)
    if args.results is None:
        args.results = prof["results"]
    if args.abc_min is None and args.abc_max is None and prof.get("abc_band") and args.band:
        args.abc_min, args.abc_max = prof["abc_band"][0], prof["abc_band"][1]
    prof, told = effective_profile(args, prof)
    con = connect()
    rows, notes, relaxed = run_query(con, args.query, args, prof)
    notes = told + notes
    hits = rank(rows, prof, args.results,
                loose_province=bool(args.province) and not args.province_strict)
    attach_doc_evidence(con, hits, norm_ws(args.query) if args.query else None)

    if args.json:
        out = []
        for score, fit, fnotes, r in hits:
            d = {k: r[k] for k in r.keys() if k != "snip"}
            d.update(score=score, fit=fit, fit_notes=fnotes, days=days_to(r["closing_at"]),
                     snippet=clean_snip(r["snip"]), matched_in=r.get("matched") or [],
                     doc_snippet=clean_snip(r.get("doc_snip") or "") or None,
                     doc_name=r.get("doc_name") or None)
            out.append(d)
        print(json.dumps({"query": args.query, "candidates": len(rows), "returned": len(out),
                          "notes": notes, "hits": out}, indent=1, default=str))
        return 0

    texts, footer = render_hits(hits, prof, budget=args.budget,
                                show_snip=not args.no_snippet)
    header = (f"{len(hits)} of {len(rows)} candidates"
              f"{'' if prof.get('_enabled') else ' (profile off)'}"
              f"  q={args.query!r}" if args.query else
              f"{len(hits)} of {len(rows)} candidates (no query: ranked by prior + soonest close)")
    print(header)
    for t in texts:
        print(t)
    for n in footer + notes:
        print(f"note: {n}")
    if args.verbose:
        tot = est_tokens(header) + sum(est_tokens(t) for t in texts) \
            + sum(est_tokens(n) for n in footer + notes)
        per = sum(est_tokens(t) for t in texts) / max(1, len(texts))
        print(f"note: ~{tot} est tokens total, ~{per:.0f}/hit "
              f"(mean budget {BUDGET_MEAN}, per-hit cap {args.budget})")
    if not hits:
        print("note: nothing matched. Widen: drop --province, raise --abc-max, add OR terms, "
              "or `rfp facets` to see where the notices actually are. 60% of "
              "category x size x province cells hold exactly one open notice nationally.")
    return 0


