    def t_budget():
        """The load-bearing one.  Verbose hits drift the economics back toward approach A."""
        measured = []
        for q, kw in [("road concreting", {}), ("supply and delivery of medical supplies", {}),
                      ("construction", {"province": ["Cavite"]}),
                      ("software information system", {}),
                      ("repair", {"abc_max": 5_000_000}),
