    def t_ro_write():
        """The headline guarantee: a model that writes DELETE gets an error, not an incident."""
        for stmt in ("delete from notices",
                     "update notices set abc = 1",
                     "insert into notices (id, source) values (1, 'x')",
                     "drop table notices",
                     "create table evil (x)",
                     "alter table notices add column evil text",
                     "insert into corpus(corpus) values('rebuild')"):
            try:
                con.execute(stmt)
                raise AssertionError(f"WRITE SUCCEEDED: {stmt!r}")
            except (sqlite3.OperationalError, sqlite3.DatabaseError, sqlite3.Warning):
                pass
        # mode=ro does not stop `attach writable.db`; the authorizer must.
        try:
            con.execute("attach database '/tmp/rfp_evil.db' as evil")
            raise AssertionError("ATTACH SUCCEEDED -- ro-mode alone is not enough")
        except sqlite3.DatabaseError:
            pass
        assert con.execute(f"select count(*) from {s['base']}").fetchone()[0] > 0, \
            "reads must still work"
    check("sql refuses every write, including ATTACH", t_ro_write)

