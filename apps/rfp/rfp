# FTS5 over external content.  `corpus` is the table the design doc's example query hits
# directly: indexed text columns plus UNINDEXED metadata, so
#   select id,title,abc,closing_at from corpus where corpus match '...' and abc between ...
# works verbatim, and the UNINDEXED values are read back from notices with their real types.
FTS_INDEXED = ["title", "agency", "category", "work_type", "scope", "keywords", "location",
               "solicitation_no", "items", "description"]
FTS_UNINDEXED = ["id", "source", "url", "mode", "mode_norm", "mode_family", "classification",
                 "needs_pcab", "eligibility", "province", "provinces", "abc", "abc_lot_min",
                 "abc_lot_max", "abc_band", "publish_at", "closing", "closing_at", "closing_dow",
                 "delivery", "status", "dupe_key"]
# BM25 weights.  Every notice contains 'Republic Act 12009' and 'non-discretionary pass/fail', so
# those score ~0 for free; the weighting just says a title hit beats a boilerplate-body hit.
FTS_WEIGHTS = {"title": 8.0, "keywords": 6.0, "scope": 5.0, "category": 2.5, "work_type": 3.0,
               "items": 2.0, "items_text": 2.0, "agency": 1.5, "location": 1.0,
               "solicitation_no": 0.5, "description": 1.0}


def fts_ddl():
    cols = ", ".join(FTS_INDEXED + [f"{c} UNINDEXED" for c in FTS_UNINDEXED])
    return f"create virtual table corpus using fts5({cols}, content='notices', tokenize='unicode61');"


def _rows(db_path, sql):
    if not Path(db_path).exists():
        return []
    con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    try:
        return con.execute(sql).fetchall()
    finally:
        con.close()


def cmd_build(args):
    out = Path(args.out) if args.out else DEFAULT_DB
    if out.exists() and not args.force:
        die(f"{out.name} already exists -- refusing to overwrite. `rfp build --force` to rebuild, "
            f"or point RFP_DB at another file.")
    if not SRC_MPHILGEPS.exists() and not SRC_LEGACY.exists():
        die(f"no source DBs: expected {SRC_MPHILGEPS.name} and/or {SRC_LEGACY.name}")
    tmp = out.with_name(out.name + ".tmp")
    if tmp.exists():
        tmp.unlink()
    db = sqlite3.connect(str(tmp))
    db.executescript("pragma journal_mode=delete; pragma synchronous=off;")
    db.executescript(NOTICES_DDL)

    tags = {}
    if SRC_TAGS.exists():
        for r in _rows(SRC_TAGS, "select * from tags"):
            tags[r["id"]] = r
    counts = {"mphilgeps": 0, "legacy": 0, "tagged": 0, "skipped_unenriched": 0}

    def stage(rows, source, mapper):
        batch, provrows = [], []
        for r in rows:
            rec = mapper(r)
            if rec is None:
                counts["skipped_unenriched"] += 1
                continue
            t = tags.get(rec["id"])
            if t:
                counts["tagged"] += 1
                rec["work_type"] = t["work_type"]
                rec["needs_pcab"] = t["needs_pcab"]
                rec["eligibility"] = t["eligibility"]
                rec["scope"] = t["scope"]
                # tags.db pilot keywords are character-shredded ('f e a s i b l t y'); a run of
                # single letters is not a keyword, so drop rather than index noise.
                kw = norm_ws(t["keywords"])
                toks = kw.split()
                rec["keywords"] = kw if toks and sum(len(x) == 1 for x in toks) < len(toks) / 2 \
                    else None
            provs = split_locations(rec.get("location"))
            rec["provinces"] = ",".join(provs) or None
            rec["province"] = provs[0] if provs else None
            rec["abc_band"] = abc_band(rec.get("abc"))
            rec["mode_family"] = mode_family(rec.get("mode_norm"))
            ca = rec.get("closing_at")
            rec["closing_dow"] = None
            if ca:
                try:
                    rec["closing_dow"] = datetime.fromisoformat(ca).weekday()
                except ValueError:
                    pass
            rec["url"] = (URL_MPHILGEPS if source == "mphilgeps" else URL_LEGACY).format(rec["id"])
            rec["source"] = source
            if not rec.get("dupe_key"):
                rec["dupe_key"] = sha1(norm_ws(rec.get("agency")).lower(), ca,
                                       norm_ws(rec.get("title")).lower()[:80], rec.get("abc"))
            batch.append(rec)
            for p in provs:
                provrows.append((rec["id"], p, _PROV_REGION.get(p.lower())))
            counts[source] += 1
        cols = [c[1] for c in db.execute("pragma table_info(notices)")]
        ph = ",".join("?" * len(cols))
        db.executemany(f"insert or replace into notices ({','.join(cols)}) values ({ph})",
                       [tuple(rec.get(c) for c in cols) for rec in batch])
        db.executemany("insert or replace into notice_province values (?,?,?)", provrows)

    def map_m(r):
        if not r["enriched_at"]:
            return None          # 12 rows: never enriched, incl. the permanent-500 zombies
        return dict(
            id=r["id"], title=norm_ws(r["title"]), agency=norm_ws(r["agency"]),
            mode=r["mode"], mode_norm=(r["mode"] or "").strip().lower(),
            classification=r["classification"], category=r["category"],
            location=r["location"], abc=r["abc"], abc_lot_min=r["abc_lot_min"],
            abc_lot_max=r["abc_lot_max"], publish=r["publish"],
            publish_at=iso_norm(r["publish_at"]), closing=r["closing"],
            closing_at=iso_norm(r["closing_at"]), delivery=r["delivery_days"],
            status=r["status"], funding=r["funding"], control=r["control"],
            lot_type=r["lot_type"], client_agency=r["client_agency"], contact=r["contact"],
            downloads=r["downloads"], closing_detail=r["closing_detail"],
            last_updated=r["updated"], description=r["description"],
            items=clean_items(r["items"]), seen_at=r["seen_at"], enriched_at=r["enriched_at"],
            fetch_errors=r["fetch_errors"],
        )

    def map_l(r):
        if not r["enriched_at"]:
            return None
        return dict(
            id=r["id"], title=norm_ws(r["title"]), agency=norm_ws(r["agency"]),
            mode=r["mode"], mode_norm=norm_ws(r["mode_norm"]).lower() or
            (r["mode"] or "").strip().lower(),
            classification=r["classification"], category=r["category"],
            location=r["location"], abc=r["abc"], publish=r["publish"],
            publish_at=iso_norm(r["publish_at"]), closing=r["closing"],
            closing_at=iso_norm(r["closing_at"]), delivery=r["delivery_period"],
            status=r["status"], contact=r["contact"], contact_email=r["contact_email"],
            contact_phone=r["contact_phone"], description=r["description"],
            solicitation_no=r["solicitation_no"], trade_agreement=r["trade_agreement"],
            bid_supplements=r["bid_supplements"], doc_req_list=r["doc_req_list"],
            last_updated=r["last_updated"], dupe_key=r["dupe_key"], seen_at=r["seen_at"],
            enriched_at=r["enriched_at"], fetch_errors=r["fetch_errors"],
        )

    if SRC_MPHILGEPS.exists():
        stage(_rows(SRC_MPHILGEPS, "select * from tenders"), "mphilgeps", map_m)
    if SRC_LEGACY.exists():
        stage(_rows(SRC_LEGACY, "select * from tenders"), "legacy", map_l)
    db.commit()

    db.execute(fts_ddl())
    db.execute("insert into corpus(corpus) values('rebuild')")
    total = db.execute("select count(*) from notices").fetchone()[0]
    for k, v in [("built_at", now_iso()), ("mphilgeps", counts["mphilgeps"]),
                 ("legacy", counts["legacy"]), ("tagged", counts["tagged"]),
                 ("skipped_unenriched", counts["skipped_unenriched"]), ("notices", total),
                 ("schema", "notices+corpus(fts5,content=notices)+notice_province"),
                 ("builder", "rfp build")]:
        db.execute("insert or replace into meta values (?,?)", (k, str(v)))
    db.commit()
    db.execute("analyze")
    db.commit()
    db.close()
    tmp.replace(out)
    print(f"built {out}  notices={total}  mphilgeps={counts['mphilgeps']} "
          f"legacy={counts['legacy']} tagged={counts['tagged']} "
          f"skipped_unenriched={counts['skipped_unenriched']}")
    return 0


# ---------------------------------------------------------------------------------------------
# read surface
# ---------------------------------------------------------------------------------------------
# The authorizer is deliberately NARROW.  Writes are already impossible -- the file is opened
# file:corpus.db?mode=ro and SQLite answers every INSERT/UPDATE/DELETE/DROP/CREATE/ALTER with
# "attempt to write a readonly database" (all nine verified in selfcheck).  What mode=ro does NOT
# stop is `attach 'writable.db' as w; insert into w...`, so ATTACH/DETACH is what gets denied.
#
# Measured trap, paid for once: denying the write actions as well BREAKS FTS5 --
# "vtable constructor failed: corpus_fts", because fts5's xConnect prepares statements against
# its own shadow tables and an INSERT-denying authorizer kills them.  A broader authorizer here
# silently costs you the entire retrieval layer, which is why it is this narrow and why the
# comment is this long.
_DENY = {getattr(sqlite3, n) for n in ("SQLITE_ATTACH", "SQLITE_DETACH")
         if hasattr(sqlite3, n)}
_DENY_PRAGMA = {"writable_schema", "journal_mode", "synchronous", "temp_store_directory",
                "data_store_directory"}


def _authorizer(action, arg1, arg2, dbname, source):
    if action in _DENY:
        return sqlite3.SQLITE_DENY
    if action == getattr(sqlite3, "SQLITE_PRAGMA", -1) and \
            str(arg1 or "").lower() in _DENY_PRAGMA:
        return sqlite3.SQLITE_DENY
    return sqlite3.SQLITE_OK


def db_path():
    env = os.environ.get("RFP_DB")
    if env:
        return Path(env)
    return DEFAULT_DB


# Auxiliary read surfaces, attached under fixed schema names so `rfp sql` can join them.
# Order matters only for the error message.
AUX_DBS = [("docs", lambda: DOCS_DB), ("tags", lambda: SRC_TAGS)]


def attach_aux(con):
    """ATTACH docs.db and tags.db read-only, BEFORE the authorizer goes on.

    The ordering is the whole trick and it is not cosmetic.  The authorizer denies SQLITE_ATTACH
    outright -- that is what stops `attach 'writable.db' as w; insert into w...`, the one hole
    mode=ro leaves open.  But a blanket denial also locks US out of the two databases the search
    layer now needs.  Attaching first and arming the authorizer second gives both: the three
    databases we intend are visible, and a model that tries to attach a fourth gets
    'not authorized'.  Verified both directions in selfcheck t_attach.

    Each aux file is itself opened `?mode=ro`, so the attached handles are read-only in their own
    right; the main connection's mode=ro does NOT propagate to attachments.  Also verified.

    Returns the list of schema names that actually attached.  A missing aux DB is not an error --
    docs.db is 718MB and gitignored, so a fresh clone has corpus.db and nothing else, and every
    read path degrades to 'not crawled' rather than to a silent empty list."""
    got = []
    for name, pathfn in AUX_DBS:
        p = pathfn()
        if not p.exists():
            continue
        try:
            con.execute(f"attach database ? as {name}", (f"file:{p}?mode=ro",))
            got.append(name)
        except sqlite3.DatabaseError:
            pass          # locked / corrupt / wrong build of sqlite: degrade, never die
    return got


def connect(strict=True):
    """Read-only, three times over.  mode=ro is SQLite's own guarantee on each file; the
    authorizer closes the `attach 'writable.db' as w; insert into w...` hole that mode=ro does
    not.  A model that writes DELETE gets an error, not an incident."""
    p = db_path()
    if not p.exists():
        die(f"{p} not found. Run `rfp build` (merges tenders.db + legacy.db + tags.db), "
            f"or set RFP_DB=/path/to/corpus.db")
    con = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    attach_aux(con)                           # must precede set_authorizer -- see attach_aux
    if strict:
        con.set_authorizer(_authorizer)
    return con


def aux_schemas(con):
    """Which aux databases are actually attached, asked of SQLite rather than remembered.
    sqlite3.Connection is a C type and rejects attribute assignment, and a cache keyed on
    id(con) goes stale the moment an id is reused after a close."""
    try:
        return {r[1] for r in con.execute("pragma database_list")} - {"main", "temp"}
    except sqlite3.DatabaseError:
        return set()


_SCHEMA_CACHE = {}
PROV_TABLES = ["notice_location", "notice_province"]      # sibling's merge, then rfp build's
FTS_TABLES = ["corpus_fts", "corpus"]                     # sibling's merge, then rfp build's


def schema(con):
    """Introspect rather than assume.

    corpus.db is built by a job this CLI does not own, and its shape is already NOT what the
    design doc sketched: the relational table is `corpus` (not `notices`), full text lives in a
    separate `corpus_fts` joined on `nid` (not on the site id), locations explode into
    `notice_location`, and derived fields the doc implies -- mode_family, abc_band, province,
    url -- do not exist as columns at all.  So: discover the base table, the FTS table and its
    join key, the location table, and synthesise every missing column as SQL.  Every read path
    below goes through expr(), so a schema change costs one entry in DERIVED, not a rewrite.
    """
    key = id(con)
    if key in _SCHEMA_CACHE:
        return _SCHEMA_CACHE[key]
    info = {}
    for (name,) in con.execute(
            "select name from sqlite_master where type in ('table','view')").fetchall():
        try:
            info[name] = [r[1] for r in con.execute(f"pragma table_info({name})")]
        except sqlite3.DatabaseError:
            info[name] = []
    base = next((t for t in ("notices", "corpus") if t in info and "title" in info[t]), None)
    if base is None:
        die("corpus.db has no table with notice columns (looked for `notices`, `corpus`); "
            "run `rfp build --force` to build one from tenders.db + legacy.db")
    cols = set(info[base])

    fts, fts_cols, fts_key = None, [], None
    for cand in FTS_TABLES:
        if cand in info and cand != base:
            fts, fts_cols = cand, info[cand]
            break
    if fts:
        sql = (con.execute("select sql from sqlite_master where name=?", (fts,)).fetchone()
               or [""])[0] or ""
        m = re.search(r"content_rowid\s*=\s*'?([A-Za-z_][A-Za-z0-9_]*)'?", sql)
        fts_key = m.group(1) if m else "rowid"
        if fts_key not in cols and fts_key != "rowid":
            fts_key = "rowid"
    elif base == "corpus" and "corpus_fts_data" in info:
        fts, fts_cols, fts_key = base, info[base], None      # base IS the FTS table
    if fts and not fts_cols:
        fts = None      # a vtab whose columns we cannot read is unusable; fall back to filters

    prov = None
    for cand in PROV_TABLES:
        if cand in info:
            pc = info[cand]
            keycol = next((k for k in ("nid", "id") if k in pc), None)
            valcol = next((v for v in ("location", "province") if v in pc), None)
            if keycol and valcol:
                prov = {"table": cand, "key": keycol, "val": valcol,
                        "norm": "location_norm" if "location_norm" in pc else None,
                        "ord": "ord" if "ord" in pc else "rowid"}
                break
    if prov and prov["key"] not in cols:
        prov = None                                          # cannot join it; fall back to LIKE

    # How many rows the tag pass has actually written.  Currently ZERO, which makes
    # --work-type a silent no-op; the filter says so rather than returning an empty list.
    tagged = None
    if "work_type" in cols:
        try:
            tagged = con.execute(
                f"select count(*) from {base} where work_type is not null").fetchone()[0]
        except sqlite3.DatabaseError:
            tagged = None
    # Aux surfaces.  `tags` matters twice over: corpus.work_type is non-null on ZERO rows in the
    # merged corpus.db (the tag pass wrote tags.db, and nothing merged it back), so --work-type,
    # `scope` and `keywords` were dead until the attach landed.  With tags.db attached they
    # resolve through DERIVED as correlated subqueries -- 9ms for a full-corpus work_type filter,
    # measured -- and no FROM clause anywhere has to change.
    aux = aux_schemas(con)
    tags_ok, docs_ok = "tags" in aux, "docs" in aux
    tag_src = "base" if tagged else None    # non-zero base count means the merge already ran
    if tags_ok:
        try:
            n = con.execute("select count(*) from tags.tags").fetchone()[0]
            tags_ok = n > 0
            if tags_ok and not tagged:
                tag_src, tagged = "tags_db", n
        except sqlite3.DatabaseError:
            tags_ok = False
    if docs_ok:
        try:
            con.execute("select 1 from docs.doc_fts limit 1").fetchone()
        except sqlite3.DatabaseError:
            docs_ok = False                # no FTS index over document text -> no doc search
    s = {"tables": info, "base": base, "cols": cols, "fts": fts, "fts_cols": fts_cols,
         "fts_key": fts_key, "prov": prov, "tagged": tagged,
         "tags_db": tags_ok, "docs_db": docs_ok, "aux": aux, "tag_src": tag_src,
         "tag_fts": "tag_fts" in info and bool(info.get("tag_fts"))}
    _SCHEMA_CACHE[key] = s
    return s


def _prov_subquery(s, select, extra=""):
    p, b = s["prov"], s["base"]
    nat = ", ".join(f"'{x}'" for x in sorted(_NATIONWIDE))
    return (f"(select {select} from {p['table']} pv where pv.{p['key']} = {b}.{p['key']} "
            f"and pv.{p['val']} is not null and trim(pv.{p['val']}) <> '' "
            f"and upper(pv.{p['val']}) not in ({nat}) {extra})")


# Columns the design doc's ranking and output need but no corpus.db actually stores.  Synthesised
# in SQL so `rfp sql` users can copy the expression, and so filters on them stay in the database.
DERIVED = {
    "url": lambda s: (
        "case {b}.source when 'legacy' then "
        "'https://notices.philgeps.gov.ph/GEPSNONPILOT/Tender/"
        "SplashBidNoticeAbstractUI.aspx?refID=' || {b}.id "
        "else 'https://philgeps.gov.ph/Indexes/viewLiveTenderDetails/' || {b}.id end"
    ).format(b=s["base"]),
    "mode_family": lambda s: sql_mode_family(f"{s['base']}.mode_norm"),
    "abc_band": lambda s: sql_abc_band(f"{s['base']}.abc"),
    "delivery": lambda s: "coalesce(" + ", ".join(
        f"{s['base']}.{c}" for c in ("delivery", "delivery_days", "delivery_period")
        if c in s["cols"]) + ")" if any(
        c in s["cols"] for c in ("delivery", "delivery_days", "delivery_period")) else "null",
    "closing_dow": lambda s: f"cast(strftime('%w', {s['base']}.closing_at) as integer)",
    "items": lambda s: (f"{s['base']}.items_text" if "items_text" in s["cols"] else "null"),
    "province": lambda s: (
        _prov_subquery(s, f"pv.{s['prov']['val']}", f"order by pv.{s['prov']['ord']} limit 1")
        if s["prov"] else f"{s['base']}.location"),
    "provinces": lambda s: (
        _prov_subquery(s, f"group_concat(pv.{s['prov']['val']}, ',')")
        if s["prov"] else f"{s['base']}.location"),
}


# PREFER: when a corpus.db carries two spellings of one field, which one wins.
PREFER = {"items": ["items_text", "items"],
          "last_updated": ["updated_at", "last_updated_at", "last_updated", "updated"]}


# Columns the tag pass owns.  They exist as (entirely NULL) columns on the merged `corpus` table
# AND as real values in tags.db, so expr() must prefer whichever one is actually populated.
TAG_COLS = {"work_type", "needs_pcab", "eligibility", "scope", "keywords",
            "deliverables", "doc_note", "doc_chars", "tag_tier"}
_TAG_COL_SQL = {"tag_tier": "tier"}


def expr(s, name, default="null"):
    """SQL expression for a canonical column: the real column, else a synthesised one, else NULL.
    Nothing downstream may reference a physical column directly."""
    # Tags first: a physically-present-but-all-NULL column must lose to a populated one in
    # tags.db, otherwise every tag-driven filter is a silent no-op returning zero rows.
    if name in TAG_COLS and s.get("tag_src") == "tags_db":
        return (f"(select tg.{_TAG_COL_SQL.get(name, name)} from tags.tags tg "
                f"where tg.id = {s['base']}.id)")
    for cand in PREFER.get(name, []):
        if cand in s["cols"]:
            return f"{s['base']}.{cand}"
    if name in s["cols"]:
        return f"{s['base']}.{name}"
    fn = DERIVED.get(name)
    if fn:
        try:
            return fn(s)
        except Exception:
            return default
    return default


def col(s, name, default="null"):
    return expr(s, name, default)


def relax(q):
    """Models write `software OR ICT OR "information system"` (valid FTS5) and also `abc:>5M` or
    `road-widening (((` (syntax errors).  On error the query is relaxed to an OR of quoted
    barewords rather than returning zero rows, because a silent empty result for a typo is the
    omission failure this corpus punishes hardest."""
    words = re.findall(r"[\w][\w'&/.\-]*", norm_ws(q))
    words = [w for w in words if w.upper() not in ("AND", "OR", "NOT", "NEAR")]
    if not words:
        return None
    return " OR ".join(f'"{w}"' for w in words)


def build_where(s, args, prof, fit_mode):
    """Every clause here is null-tolerant on purpose.  `abc <= X` that drops the 39 null-ABC rows
    (some published the same day) is the bug the design doc singles out."""
    where, params, notes = [], [], []

    # The 12 unenriched rows are the permanent-HTTP-500 zombies (ids 2208-2239): no ABC, no
    # closing date, no detail. 22,080 rows - 12 = the 22,068 the design doc counts.
    if "enriched_at" in s["cols"] and not getattr(args, "include_unenriched", False):
        where.append(f"{expr(s,'enriched_at')} is not null")
    if args.work_type and s.get("tagged") == 0:
        notes.append("--work-type matches NOTHING: the tag pass has not run, work_type is null "
                     "on every row. Filter on title/items text instead (see SKILL.md).")
    if args.source:
        where.append(f"{col(s,'source')} = ?")
        params.append(args.source)
    if args.work_type:
        wts = [w.strip() for a in args.work_type for w in str(a).split(",") if w.strip()]
        where.append("(" + " or ".join([f"{expr(s,'work_type')} = ?"] * len(wts)) + ")")
        params += wts
    if args.mode_family:
        mfs = [w.strip() for a in args.mode_family for w in str(a).split(",") if w.strip()]
        where.append("(" + " or ".join([f"({expr(s,'mode_family')}) = ?"] * len(mfs)) + ")")
        params += mfs
    if args.mode:
        where.append(f"lower({col(s,'mode_norm',repr(''))}) like ?")
        params.append(f"%{args.mode.lower()}%")
    if args.agency:
        where.append(f"lower({col(s,'agency',repr(''))}) like ?")
        params.append(f"%{args.agency.lower()}%")
    if args.classification:
        where.append(f"lower({col(s,'classification',repr(''))}) like ?")
        params.append(f"%{args.classification.lower()}%")

    # --- ABC.  Multi-lot notices are findable by their PER-LOT range: notice 54278 is a P360K
    # notice made of six P60K lots, and a bidder filtering abc<=100K must see it.
    lo, hi = args.abc_min, args.abc_max
    if lo is not None or hi is not None:
        a = expr(s, "abc")
        amin, amax = expr(s, "abc_lot_min"), expr(s, "abc_lot_max")
        clauses, tot = [], []
        if lo is not None:
            tot.append(f"{a} >= ?")
        if hi is not None:
            tot.append(f"{a} <= ?")
        clauses.append("(" + " and ".join(tot) + ")")
        params += [x for x in (lo, hi) if x is not None]
        if "abc_lot_min" in s["cols"] and "abc_lot_max" in s["cols"]:
            lot = [f"{amax} >= ?" if lo is not None else None,
                   f"{amin} <= ?" if hi is not None else None]
            clauses.append("(" + " and ".join(c for c in lot if c) + ")")  # lot range overlaps
            params += [x for x in (lo, hi) if x is not None]
        if not args.strict_abc:
            clauses.append(f"{a} is null")
            notes.append("abc filter includes the 39 notices with no stated ABC "
                         "(--strict-abc excludes them)")
        where.append("(" + " or ".join(clauses) + ")")

    # --- geography.  Match against the exploded per-province rows and against every spelling of
    # each province; never compare `location` for equality -- 103 rows are comma-multi-valued
    # ('Batangas,Laguna,Quezon,Rizal') and `location = 'Laguna'` misses all of them.
    provs = [p.strip() for a in (args.province or []) for p in str(a).split(",") if p.strip()]
    if provs:
        want = set()
        for p in provs:
            hit = next((pl for rn, pl in REGIONS.items() if p.lower() == rn.lower()), None)
            for name in (hit or [p]):
                want |= province_variants(name)
        want = sorted(want)
        ph = ",".join("?" * len(want))
        pt = s["prov"]
        if pt:
            match = f"upper(pv.{pt['val']}) in ({ph})"
            binds = list(want)
            if pt["norm"]:
                match = f"({match} or upper(coalesce(pv.{pt['norm']},'')) in ({ph}))"
                binds = list(want) + list(want)
            clause = (f"exists (select 1 from {pt['table']} pv "
                      f"where pv.{pt['key']} = {s['base']}.{pt['key']} and {match})")
            params += binds
        else:                                   # no exploded table: LIKE per token, still no '='
            clause = "(" + " or ".join(
                [f"upper(coalesce({expr(s,'location')},'')) like ?"] * len(want)) + ")"
            params += [f"%{w}%" for w in want]
        locnull = (f"({expr(s,'location')} is null or trim({expr(s,'location')}) = '' "
                   f"or upper({expr(s,'location')}) = 'PHILIPPINES')")
        if args.province_strict:
            where.append(clause)
        else:
            where.append(f"({clause} or {locnull})")
            notes.append("province filter also keeps notices with no stated location (8.7% corpus-wide, 12.2% of mPhilGEPS) "
                         "(--province-strict drops them)")

    # --- time.  `closing_at` is nullable and the null rows must not sort first.
    ca = expr(s, "closing_at")
    if not args.include_closed:
        where.append(f"({ca} >= ? or {ca} is null)")
        params.append(datetime.now().replace(microsecond=0).isoformat())
    if args.closing_before:
        where.append(f"{ca} <= ?")
        params.append(args.closing_before + "T23:59:59")
    if args.closing_after:
        where.append(f"{ca} >= ?")
        params.append(args.closing_after + "T00:00:00")
    if args.days_max is not None:
        where.append(f"julianday({ca}) - julianday('now') <= ?")
        params.append(args.days_max + 1)
    if args.days_min is not None:
        where.append(f"julianday({ca}) - julianday('now') >= ?")
        params.append(args.days_min)
    return where, params, notes


SELECT_COLS = ["id", "source", "url", "title", "agency", "mode", "mode_norm", "mode_family",
               "classification", "category", "work_type", "needs_pcab", "eligibility", "scope",
               "keywords", "location", "province", "provinces", "abc", "abc_lot_min",
               "abc_lot_max", "abc_band", "closing", "closing_at", "publish_at", "status",
               "delivery"]


# ---------------------------------------------------------------------------------------------
# Three indexes, joined by notice id.  See the DOC_WEIGHT comment at the top for why attachment
# text is NOT merged into corpus_fts.
#
#   corpus_fts   notice text      title / description / items_text / category / agency   (22,080)
#   tag_fts      distilled text   scope / keywords / deliverables from the Luna pass      (22,068)
#   docs.doc_fts attachment text  extracted document text + human filenames, per blob      (8,337)
#
# Every hit reports which of the three it matched, because a ranking a cheap model cannot audit
# is indistinguishable from vibes.
# ---------------------------------------------------------------------------------------------
PROV_LABEL = {"title": "ttl", "description": "desc", "items_text": "items", "items": "items",
              "agency": "agcy", "category": "cat", "location": "loc", "keywords": "kw",
              "scope": "scope", "deliverables": "deliv", "solicitation_no": "ref",
              "work_type": "wt", "att": "att"}
# Print order, so provenance reads the same way every time.
PROV_ORDER = ["ttl", "scope", "kw", "deliv", "items", "desc", "cat", "agcy", "loc", "ref", "wt",
              "att"]

_BLOB_MAP = {}


def blob_notice_map(con):
    """{blob_id: [notice_id, ...]} for every attached document.

    Loaded whole (9,827 rows, measured 6ms) rather than joined per query.  Blobs are deduped by
    sha256 in docs.db, so ONE blob legitimately belongs to several notices -- the same ITB
    boilerplate posted by the same PE under six refIDs -- and a doc-text hit must light up all of
    them, not an arbitrary one."""
    key = id(con)
    if key not in _BLOB_MAP:
        m = {}
        try:
            for blob_id, nid in con.execute(
                    "select distinct blob_id, notice_id from docs.documents "
                    "where blob_id is not null"):
                m.setdefault(blob_id, []).append(nid)
        except sqlite3.DatabaseError:
            m = {}
        _BLOB_MAP[key] = m
    return _BLOB_MAP[key]


def doc_match(con, match_expr, cap=DOC_MATCH_CAP):
    """Attachment-text hits, aggregated blob-level -> notice-level.

    Returns {notice_id: {"rel": float, "blob": blob_id, "ndocs": int}} where rel is positive and
    larger-is-better (bm25 returns negative).

    Per notice the score is the BEST matching blob, never the sum.  Summing would rank a notice
    by how many PDFs it happens to carry -- an artifact of how the BAC packaged the bid docs, not
    a relevance signal -- and notices carry up to 40 documents.

    Two-phase on purpose: score every matching blob here (cheap, no snippets), then fetch
    snippets for the handful of blobs that actually survive ranking.  Computing snippets for the
    5,908 blobs that match a query like 'the OR and OR of' would cost seconds for output nobody
    reads."""
    w = ", ".join(str(x) for x in DOC_FTS_WEIGHTS)
    try:
        rows = con.execute(
            f"select rowid, bm25(doc_fts, {w}) as s from docs.doc_fts "
            f"where doc_fts match ? limit ?", (match_expr, cap)).fetchall()
    except sqlite3.DatabaseError:
        return {}
    m = blob_notice_map(con)
    by = {}
    for blob_id, sc in rows:
        rel = -float(sc or 0.0)
        for nid in m.get(blob_id, ()):
            cur = by.get(nid)
            if cur is None:
                by[nid] = {"rel": rel, "blob": blob_id, "ndocs": 1}
            else:
                cur["ndocs"] += 1
                if rel > cur["rel"]:
                    cur["rel"], cur["blob"] = rel, blob_id
    return by


def tag_match(con, s, match_expr, cap=DOC_MATCH_CAP):
    """Hits against the distilled tag text (scope / keywords / deliverables).

    This is the channel that answers 'what is actually being bought', because the notice
    description is ~2,086 chars of RA 12009 boilerplate and the title is often a purchase-order
    number.  Absent until `rfp reindex` has run; absence degrades to no tag channel, never to an
    error."""
    if not s.get("tag_fts"):
        return {}
    try:
        rows = con.execute(
            "select rowid, bm25(tag_fts, 5.0, 4.0, 3.0) as s from tag_fts "
            "where tag_fts match ? limit ?", (match_expr, cap)).fetchall()
    except sqlite3.DatabaseError:
        return {}
    return {int(r[0]): -float(r[1] or 0.0) for r in rows}


def _col_ids(con, s, table, column, match_expr, key_sql):
    """Notice ids whose `column` matched, for provenance.  One scoped MATCH per column,
    sub-millisecond each (measured), so provenance costs ~5 extra FTS probes per search."""
    try:
        return {int(r[0]) for r in con.execute(
            f"select {key_sql} from {table} where {table} match ?",
            (f"{{{column}}} : ({match_expr})",))}
    except sqlite3.DatabaseError:
        return set()          # a query FTS5 will not accept per-column: skip that channel


def provenance(con, s, match_expr, doc_ids, tag_ids):
    """{notice_id: [short label, ...]} -- WHERE each hit matched.

    Notice-side channels are recovered by re-running the query restricted to one column at a
    time.  FTS5 has no 'which column matched' aux function, and the alternatives (parsing
    highlight() output, or one FTS table per column) are both worse than five cheap probes."""
    out = {}
    ft, base = s.get("fts"), s["base"]
    if match_expr and ft:
        jk = s.get("fts_key") or "rowid"
        if ft == base:
            key_sql = f"{base}.id"
            frm = ft
        else:
            key_sql = f"{base}.id"
            frm = f"{ft} join {base} on {base}.{jk} = {ft}.rowid"
        for c in s.get("fts_cols", []):
            lab = PROV_LABEL.get(c)
            if not lab:
                continue
            try:
                ids = {int(r[0]) for r in con.execute(
                    f"select {key_sql} from {frm} where {ft} match ?",
                    (f"{{{c}}} : ({match_expr})",))}
            except sqlite3.DatabaseError:
                continue
            for i in ids:
                out.setdefault(i, []).append(lab)
    for i in tag_ids:
        out.setdefault(i, []).append("scope")
    for i in doc_ids:
        out.setdefault(i, []).append("att")
    rankmap = {lab: n for n, lab in enumerate(PROV_ORDER)}
    for i, labs in out.items():
        out[i] = sorted(set(labs), key=lambda x: rankmap.get(x, 99))
    return out


def doc_snippets(con, blob_ids, match_expr, width=14):
    """Snippet from the winning blob, plus its human filename -- the evidence line for an
    attachment match.  Fetched only for blobs that survived ranking."""
    if not blob_ids:
        return {}
    out = {}
    ph = ",".join("?" * len(blob_ids))
    try:
        for r in con.execute(
                f"select rowid, snippet(doc_fts, 0, '**', '**', '…', ?), "
                f"       snippet(doc_fts, 1, '', '', '', 6) "
                f"from docs.doc_fts where doc_fts match ? and rowid in ({ph})",
                [width, match_expr] + list(blob_ids)):
            out[int(r[0])] = {"snip": r[1] or "", "name": r[2] or ""}
    except sqlite3.DatabaseError:
        return {}
    return out


def doc_names(con, blob_ids):
    """Human filename per blob, for hits whose snippet could not be produced."""
    if not blob_ids:
        return {}
    ph = ",".join("?" * len(blob_ids))
    try:
        return {int(r[0]): (r[1] or "") for r in con.execute(
            f"select blob_id, names from docs.blobs where blob_id in ({ph})", list(blob_ids))}
    except sqlite3.DatabaseError:
        return {}


def run_query(con, q, args, prof, pool=None):
    """Fetch a candidate pool, largest-BM25-first when there is a query, then let Python rerank
    with the profile prior.  Two stages because the prior must be able to PROMOTE something BM25
    ranked 300th (a multi-lot notice whose lot fits your band) without pulling the whole corpus."""
    s = schema(con)
    where, params, notes = build_where(s, args, prof, True)
    pool = pool or max(args.pool, args.results * 12)
    sel = ", ".join(f"({expr(s,c)}) as {c}" for c in SELECT_COLS)
    relaxed = False
    widened = False   # widened for recall, unlike `relaxed` which means FTS5 rejected the query
    match_expr = norm_ws(q) or None

    def attempt(e):
        if e and s["fts"]:
            ft = s["fts"]
            weights = ", ".join(str(FTS_WEIGHTS.get(c, 1.0)) for c in s["fts_cols"])
            snip = f"snippet({ft}, -1, '**', '**', '…', 9)"
            if ft == s["base"]:                     # base table IS the FTS table
                frm = f"{ft}"
                cond = [f"{ft} match ?"]
            else:
                jk = s["fts_key"] or "rowid"
                lhs = "rowid" if jk == "rowid" else jk
                frm = f"{ft} join {s['base']} on {s['base']}.{lhs} = {ft}.rowid"
                cond = [f"{ft} match ?"]
            sql = (f"select {sel}, -bm25({ft}, {weights}) as rel, {snip} as snip from {frm} "
                   f"where " + " and ".join(cond + where) + " order by rel desc limit ?")
            return con.execute(sql, [e] + params + [pool]).fetchall()
        ca = expr(s, "closing_at")
        order = f"case when {ca} is null then 1 else 0 end, {ca} asc"
        sql = (f"select {sel}, 0.0 as rel, null as snip from {s['base']}"
               + (" where " + " and ".join(where) if where else "")
               + f" order by {order} limit ?")
        return con.execute(sql, params + [pool]).fetchall()

    if match_expr and s["fts"]:
        try:
            rows = attempt(match_expr)
        except sqlite3.OperationalError as e:
            # Do not sniff the message.  FTS5 rejects a bad match expression with any of
            # 'fts5: syntax error', 'no such column: abc' (from `abc:>5M`, read as a column
            # filter), 'malformed MATCH expression'.  Relax and retry; if the retry fails too the
            # fault is ours, so re-raise the original.
            r2 = relax(q)
            if not r2:
                die(f"unusable query: {q!r} ({e})")
            try:
                rows = attempt(r2)
            except sqlite3.OperationalError:
                raise e
            relaxed = True
            notes.append(f"{q!r} is not a valid FTS5 expression ({e}); relaxed to: {r2}")
        # A VALID query that ANDs itself down to nothing is the worse failure, because it raises
        # no error at all. FTS5 reads a bare `vehicle spare parts repair` as an implicit AND of
        # every term: it matches 0 of 489 Cavite notices, while `vehicle` alone matches 40, because
        # this corpus writes "Parts and Materials". Measured cost of not doing this: recall 0.12
        # instead of 0.53 on the eval slice. Relax on an empty result, not just on a raised error.
        want_n = getattr(args, "results", 10) or 10
        # Only a BARE multi-word query gets widened. A query carrying quotes, OR/NOT/NEAR, a
        # prefix `*` or a `col:` filter is deliberate, and widening it destroys the intent --
        # '"slump test"' is a phrase that means the phrase, not `slump OR test`.
        bare = bool(q) and not re.search(r'["*:()]|\b(?:AND|OR|NOT|NEAR)\b', q)
        if bare and not relaxed and not widened and len(rows) < want_n:
            # Trigger on "could not fill the page", not just on zero. FTS5 reads a bare
            # `vehicle spare parts repair` as an implicit AND of all four terms: 48 matches
            # corpus-wide against 3,683 for the OR, and ~0 once a province filter applies, because
            # this corpus writes "Parts and Materials". A too-narrow AND raises no error, so the
            # syntax-error path never sees it -- that alone cost 24 recall points on the eval slice.
            # Only adopt the relaxed form if it genuinely returns more.
            r2 = relax(q)
            if r2 and r2 != match_expr:
                try:
                    wider = attempt(r2)
                except sqlite3.OperationalError:
                    wider = []
                if len(wider) > len(rows):
                    notes.append(f"{q!r} as written matched only {len(rows)} notices "
                                 f"(FTS5 ANDs bare terms); widened to OR: {r2}")
                    rows, widened = wider, True
    else:
        if match_expr and not s["fts"]:
            notes.append("this corpus.db has no FTS index; query text ignored, filters applied")
        rows = attempt(None)

    rows = [dict(r) for r in rows]
    if match_expr:
        eff = relax(q) if relaxed else match_expr
        rows = _fold_aux_channels(con, s, rows, eff, args, where, params, pool, notes)
    else:
        for r in rows:
            r["doc_rel"] = r["tag_rel"] = 0.0
            r["doc_blob"] = r["doc_ndocs"] = None
            r["matched"] = []
    return rows, notes, relaxed


def _fold_aux_channels(con, s, rows, match_expr, args, where, params, pool, notes):
    """Merge the tag and attachment channels into the notice-text candidate pool.

    The union step is the point of the whole night: a notice whose ONLY match is on page 12 of an
    annexed Bill of Quantities is not in `rows` at all, because corpus_fts has never seen that
    text.  Fetching those notices separately -- under the SAME filters, so an attachment hit
    cannot smuggle a closed or out-of-band notice past a WHERE clause -- is what makes attachment
    text searchable rather than merely stored."""
    want_docs = s.get("docs_db") and not getattr(args, "no_docs_text", False)
    dm = doc_match(con, match_expr) if want_docs else {}
    tm = tag_match(con, s, match_expr) if not getattr(args, "no_tag_text", False) else {}

    have = {r["id"] for r in rows}
    extra = [i for i in set(dm) | set(tm) if i not in have]
    # Bound the second fetch the same way the first one is bounded.  Ranked by the better of the
    # two aux signals so the cap keeps the best candidates, not an arbitrary id-ordered slice.
    extra.sort(key=lambda i: max(dm.get(i, {}).get("rel", 0.0), tm.get(i, 0.0)), reverse=True)
    extra = extra[:pool]
    if extra:
        sel = ", ".join(f"({expr(s,c)}) as {c}" for c in SELECT_COLS)
        for chunk in [extra[i:i + 500] for i in range(0, len(extra), 500)]:
            ph = ",".join("?" * len(chunk))
            sql = (f"select {sel}, 0.0 as rel, null as snip from {s['base']} where "
                   + " and ".join(where + [f"{expr(s,'id')} in ({ph})"]))
            rows.extend(dict(r) for r in con.execute(sql, params + list(chunk)))

    prov = provenance(con, s, match_expr, set(dm), set(tm))
    for r in rows:
        i = r["id"]
        d = dm.get(i)
        r["doc_rel"] = d["rel"] if d else 0.0
        r["doc_blob"] = d["blob"] if d else None
        r["doc_ndocs"] = d["ndocs"] if d else None
        r["tag_rel"] = tm.get(i, 0.0)
        r["matched"] = prov.get(i, [])
    if dm:
        # `extra` is the union of the doc AND tag channels, so attributing all of it to the
        # attachment channel printed nonsense like "matched 1689 notices (2521 of them
        # invisible)". Cosmetic, except the driving model reads this note as evidence.
        doc_only = [i for i in extra if i in dm]
        notes.append(f"attachment text matched {len(dm)} notices "
                     f"({len(doc_only)} of them invisible to notice-text search)")
    elif want_docs:
        notes.append("no attachment-text matches (only 4,285 of 22,080 notices have documents; "
                     "legacy's document listing is auth-gated)")
    return rows


# ---------------------------------------------------------------------------------------------
# profile_fit -- a prior, never a filter.  Multiplicative, floored at 0.2, never zero.
# ---------------------------------------------------------------------------------------------
def profile_fit(row, prof, want_prov=None, adj_prov=None):
    if not prof.get("_enabled"):
        return 1.0, []
    pen, hard, notes = [], [], []
    cats = [c.lower() for c in prof.get("categories") or []]
    never = [c.lower() for c in prof.get("never") or []]
    wt = (row["work_type"] or "").lower() or None

    if wt and never and wt in never:
        hard.append(0.30)
        notes.append((1, f"never: {wt}"))
    elif cats:
        if wt is None:
            pen.append(0.90)
            notes.append((5, "untagged"))
        elif wt in cats:
            pass
        else:
            pen.append(0.70)
            notes.append((5, f"off-category: {wt}"))

    band = prof.get("abc_band")
    if band and len(band) == 2:
        lo, hi = float(band[0]), float(band[1])
        abc, lmin, lmax = row["abc"], row["abc_lot_min"], row["abc_lot_max"]
        if abc is None:
            pen.append(0.80)
            notes.append((0, "abc: not stated"))
        elif lo <= abc <= hi:
            pass
        elif lmin is not None and lmax is not None and lmax >= lo and lmin <= hi:
            pen.append(0.95)
            notes.append((0, f"lot fits: {peso(lmin)}-{peso(lmax)} lots in a {peso(abc)} notice"))
        elif abc > hi:
            pen.append(0.55 if abc <= hi * 3 else 0.35)
            notes.append((0, f"stretch: {peso(abc)} vs your {peso(hi)} band"))
        else:
            pen.append(0.60)
            notes.append((0, f"below band: {peso(abc)} vs your {peso(lo)} floor"))

    if want_prov:
        provs = [p.strip().lower() for p in (row["provinces"] or "").split(",") if p.strip()]
        if provs:
            if any(p in want_prov for p in provs):
                pass
            elif adj_prov and any(p in adj_prov for p in provs):
                pen.append(0.85)
                notes.append((3, f"adjacent: {row['province']}"))
            else:
                pen.append(0.50)
                notes.append((3, f"out of region: {row['province']}"))
        else:
            # location blank: fall back to the agency name, which recovers 40.5% of these at
            # 96.3% precision.  Weaker than a stated location, so it never scores a clean 1.0.
            g = agency_province(row["agency"])
            gl = (g or "").lower()
            if not g:
                pen.append(0.85)
                notes.append((5, "location not stated"))
            elif gl in want_prov:
                pen.append(0.95)
                notes.append((4, f"~{g} (from agency name)"))
            elif adj_prov and gl in adj_prov:
                pen.append(0.80)
                notes.append((3, f"~{g}, adjacent (from agency)"))
            else:
                pen.append(0.55)
                notes.append((3, f"~{g}, out of region (from agency)"))

    # PCAB.  Only needs_pcab is modelled.  The ABC-to-required-class (ARCC) thresholds are NOT
    # modelled -- inventing them would fabricate eligibility, so a class-vs-size mismatch is a
    # question for `rfp show`, not a score.
    if row["needs_pcab"] and not prof.get("pcab"):
        pen.append(0.60)
        notes.append((2, "needs PCAB; profile has none"))

    need = int(prof.get("min_days_to_close") or 0)
    d = days_to(row["closing_at"])
    if d is None:
        pen.append(0.70)
        notes.append((1, "no closing date"))
    elif d < 0:
        hard.append(0.15)
        notes.append((1, "CLOSED"))
    elif need and d < need:
        pen.append(max(0.35, 0.35 + 0.65 * (d / need)))
        notes.append((1, f"tight: {d}d vs your {need}d"))

    # Sorted by how much the reader needs it, because format_hit drops the tail under budget
    # pressure: money first, then time, then licence, then geography, then the low-information
    # corpus-wide ones ("untagged" fires on 100% of rows today and must never crowd out
    # "lot fits", which is the whole point of surfacing a multi-lot notice).
    # Soft demotions compose SUB-LINEARLY; declared exclusions do not.
    #
    # A plain running product turned three mild demotions into a hard exclusion: notice 13171857
    # (heavy-equipment parts, P188K, closing in 1 day) scored below-band 0.60 x tight 0.48 x
    # off-category 0.70 = 0.20, the floor -- the same fit as a category in the profile's `never`
    # list, which is exactly what S3 forbids. Taking min() instead fixed that but broke something
    # worse: it erased mild-vs-harsh distinctions inside one row, so "lot fits" and "stretch"
    # both scored 0.456 and multi-lot notices stopped surfacing at all.
    #
    # So: dampen each soft penalty toward 1.0 before multiplying. Every signal still moves the
    # score in the right direction (nothing is erased) but three mild ones can no longer sum to an
    # exclusion. `never` and CLOSED are the user's own declaration and a fact respectively, so they
    # multiply in at full strength and stay severe.
    DAMP = 0.6
    fit = 1.0
    for f in hard:
        fit *= f
    for f in pen:
        fit *= 1.0 - DAMP * (1.0 - f)
    return max(0.20, round(fit, 3)), [x for _, x in sorted(notes, key=lambda t: t[0])]
def rank(rows, prof, results, loose_province=False):
    want, adj = profile_provinces(prof) if prof.get("_enabled") else (None, None)
    # No query means no BM25 signal at all: every rel is 0.0, so multiplying by it made every
    # score 0.0 and the profile prior was silently ignored -- a filter-only search came back
    # ordered by closing date with the worst-fitting notice first.  When there is no relevance
    # signal, the prior IS the ranking.
    mx = max((r["rel"] for r in rows), default=0.0)
    # The three channels are normalised independently and then summed with weights, rather than
    # thrown into one BM25 term space.  Independent normalisation is what stops attachment bulk
    # from eating the ranking: a 200-page annex and a 40-char title each top out at 1.0 in their
    # own channel, so the weights -- not the character counts -- decide who wins.
    dmx = max((r.get("doc_rel") or 0.0 for r in rows), default=0.0)
    tmx = max((r.get("tag_rel") or 0.0 for r in rows), default=0.0)
    div = 1.0 + (DOC_WEIGHT if dmx > 0 else 0.0) + (TAG_WEIGHT if tmx > 0 else 0.0)
    any_signal = mx > 0 or dmx > 0 or tmx > 0
    scored = []
    for r in rows:
        fit, notes = profile_fit(r, prof, want, adj)
        if not any_signal:
            base = 1.0
        else:
            n = (r["rel"] / mx) if mx > 0 else 0.0
            d = ((r.get("doc_rel") or 0.0) / dmx) if dmx > 0 else 0.0
            t = ((r.get("tag_rel") or 0.0) / tmx) if tmx > 0 else 0.0
            base = (n + DOC_WEIGHT * d + TAG_WEIGHT * t) / div
        scored.append((round(base * fit, 4), fit, notes, r))
    scored.sort(key=lambda t: (-t[0], t[3]["closing_at"] or "9999"))
    if loose_province:
        scored = _cap_unlocated(scored, results)
    return scored[:results]


NULL_LOC_SHARE = 0.30    # at --results 40 that is 12 slots, leaving 28 for province-matched rows


def _cap_unlocated(scored, results):
    """Stop location-null notices from eating a --province search's result budget.

    Keeping them is correct -- 8.7% of the corpus has no stated location and dropping them is the
    silent-omission bug. But they then compete for the same slots at fit 0.85 while BM25 has no
    idea they are in the wrong province. Measured on the Cavite eval slice: only 82 of 200
    returned rows were actually in Cavite, and 113 of the other 118 had no location at all --
    about 24 recall points paid for rows the user did not ask for.

    So: quota, not exclusion. Located rows fill up to (1 - NULL_LOC_SHARE) of the slots first,
    unlocated rows are capped, and if there are not enough located rows the leftovers are
    backfilled so the result count never shrinks.
    """
    quota = max(1, int(results * NULL_LOC_SHARE))
    located, unlocated = [], []
    for t in scored:
        (located if (t[3]["location"] or "").strip() else unlocated).append(t)
    # A CAP, not a reservation. Capping the unlocated pool and then letting everything compete on
    # score is right; pre-allocating slots to unlocated rows is wrong and cost recall at small
    # --results (at n=3 it forced one unlocated row in even when three located rows were available).
    keep = located + unlocated[:quota]
    keep.sort(key=lambda t: (-t[0], t[3]["closing_at"] or "9999"))
    if len(keep) < results:                     # backfill rather than return fewer hits
        seen = {id(t) for t in keep}
        keep += [t for t in scored if id(t) not in seen][:results - len(keep)]
        keep.sort(key=lambda t: (-t[0], t[3]["closing_at"] or "9999"))
    return keep


