    def t_spec_query():
        """The design doc's example query, adapted to the schema that actually shipped.

        The doc writes `from corpus where corpus match ...` -- one FTS table carrying the
        metadata.  The merge that shipped splits it: `corpus` is a plain table, `corpus_fts` is
        external-content FTS5 joined on `corpus.nid = corpus_fts.rowid`.  So the doc's literal
        query does NOT run, and SKILL.md documents the shape that does.  This asserts both, so
        the day corpus.db changes shape, this test says so instead of search quietly degrading.
        """
        assert s["fts"], "no FTS table found: search would fall back to filters only"
        b, ft = s["base"], s["fts"]
        join = ("" if ft == b else
                f" join {b} on {b}.{s['fts_key'] or 'rowid'} = {ft}.rowid")
        rows = con.execute(
            f"select {b}.id, {b}.title, {b}.abc, {b}.closing_at from {ft}{join} "
            f"where {ft} match 'software OR ICT OR \"information system\"' "
            f"  and {b}.abc between 1000000 and 5000000 "
            f"  and {b}.closing_at > date('now','+7 days') "
            f"order by rank limit 40").fetchall()
        assert all(isinstance(r["abc"], float) for r in rows), \
            "abc must come back numeric, not text"
        if ft != b:
            try:
                con.execute(f"select id from {b} where {b} match 'road'").fetchall()
                raise AssertionError(
                    "the base table now answers MATCH -- the doc's literal query works and "
                    "SKILL.md's 'join corpus_fts' guidance is stale")
            except sqlite3.OperationalError:
                pass
    check("the design doc's example SQL runs in its shipped shape", t_spec_query)

