  dupe_key      text,                  -- candidate generator ONLY; never auto-merge
  seen_at       text, enriched_at text, fetch_errors integer
);
create index notices_closing on notices(closing_at);
create index notices_abc on notices(abc);
create index notices_wt on notices(work_type);
create index notices_mf on notices(mode_family);
create index notices_src on notices(source);
