        assert got.get("text") is None, "docs_for() must not fetch text unless asked"
        txt = doc_text_for([did])
        assert txt.get(did), f"doc_text_for({did}) returned no text; the blobs join is broken"
        selfcheck.docs = (f"{note}; probe notice {nid} -> {len(d.get(nid, []))} documents, "
                          f"doc {did} -> {len(txt[did]):,} chars")
    check("docs listing separates 'no attachments' from 'never crawled', text is opt-in", t_docs)

    def t_attach():
        """The attach-then-authorize ordering, both directions.  Get this backwards and either
        the aux databases are invisible (search silently loses two of three channels) or the
        `attach a writable db and INSERT into it` hole reopens."""
        aux = aux_schemas(con)
        assert "docs" in aux or not DOCS_DB.exists(), f"docs.db not attached: {aux}"
        assert "tags" in aux or not SRC_TAGS.exists(), f"tags.db not attached: {aux}"
        # every attached file is read-only in its own right (main's mode=ro does not propagate)
        for sql in ("insert into docs.skips(at) values('x')",
                    "update tags.tags set work_type='x'",
                    "delete from docs.documents"):
            tbl = sql.split()[1].split("(")[0].split(".")[0]
            if tbl not in aux:
                continue
            try:
                con.execute(sql)
                raise AssertionError(f"WROTE to an attached db: {sql}")
            except sqlite3.DatabaseError as e:
                assert "readonly" in str(e).lower() or "not authorized" in str(e).lower(), e
        # and no FOURTH database can be attached after the authorizer is armed
        try:
            con.execute("attach database ? as w", (str(HERE / "corpus.db"),))
            raise AssertionError("ATTACH was permitted after the authorizer was armed")
        except sqlite3.DatabaseError as e:
            assert "not authorized" in str(e).lower(), e
        selfcheck.attach = f"attached {sorted(aux)}; all read-only; further ATTACH denied"
    check("aux DBs attach read-only, and further ATTACH is still denied", t_attach)

    def t_tag_wiring():
        """corpus.work_type is NULL on every row of the merged corpus.db -- the tag pass wrote
        tags.db and nothing merged it back.  If expr() stops preferring tags.db, --work-type
        silently becomes a no-op that returns zero rows, which is the omission failure."""
        if not s.get("tags_db"):
            return "SKIPPED (tags.db absent)"
        n = con.execute(f"select count(*) from {s['base']} "
                        f"where ({expr(s,'work_type')}) = 'civil_works'").fetchone()[0]
        assert n > 100, f"only {n} civil_works rows; the tags.db join is broken"
        a = _args_for_search(results=5, work_type=["civil_works"])
        rows, _, _ = run_query(con, "road", a, {"_enabled": False})
        assert rows, "--work-type civil_works returned nothing"
        assert all(r["work_type"] == "civil_works" for r in rows), \
            "a --work-type filter let a different work_type through"
        assert any(r["scope"] for r in rows), "scope never populated from tags.db"
        selfcheck.tagwire = f"{n} civil_works rows visible through tags.db"
    check("tag columns resolve through the attached tags.db, not the empty base columns",
          t_tag_wiring)

    def t_doc_search():
        """The point of the night: text that exists ONLY in an attachment must be findable, and
        the hit must say so."""
        if not s.get("docs_db"):
            return "SKIPPED (docs.db absent)"
        # A term that lives almost entirely in attachments.  'backhoe' would be a bad probe: it
        # appears in 85 notice titles, so the attachment-only hits are CORRECTLY outranked and
        # the test would fail on working code.  "slump test" is a concrete QC clause that
        # appears in 158 notices' documents and exactly 1 notice's own text.
        probe = '"slump test"'
        dm = doc_match(con, probe)
        assert dm, f"{probe!r} matched no attachment text at all"
        # It must reach notices whose own text never mentions the term -- otherwise the
        # attachment index is decorative and notice-text search would have found them anyway.
        ph = ",".join("?" * len(dm))
        vis = {r[0] for r in con.execute(
            f"select {s['base']}.id from {s['fts']} "
            f"join {s['base']} on {s['base']}.{s['fts_key']} = {s['fts']}.rowid "
            f"where {s['fts']} match ? and {s['base']}.id in ({ph})",
            [probe] + list(dm))}
        only_doc = set(dm) - vis
        assert only_doc, \
            f"every {probe!r} attachment hit was already visible in notice text -- no recall gain"
        # and the end-to-end search must actually return one of them, marked @att
        a = _args_for_search(results=25)
        rows, _, _ = run_query(con, probe, a, {"_enabled": False})
        hits = rank(rows, {"_enabled": False}, 25)
        att = [r for _, _, _, r in hits if "att" in (r.get("matched") or [])]
        assert att, f"no hit for {probe!r} was marked as an attachment match"
        assert any(r["id"] in only_doc for _, _, _, r in hits), \
            "search returned no attachment-only notice; the union step is not working"
        selfcheck.docsearch = (f"{probe!r}: {len(dm)} notices via attachments, "
                               f"{len(only_doc)} of them invisible to notice text")
    check("attachment-only text is findable end-to-end and marked @att", t_doc_search)

    def t_doc_weight():
        """The failure the brief names: a notice whose PDF repeats a word must not outrank a
        notice whose TITLE is an exact match.  Asserted on the arithmetic, not on a vibe."""
        def mk(rel, doc_rel):
            return {"rel": rel, "doc_rel": doc_rel, "tag_rel": 0.0, "closing_at": "2026-09-01",
                    "abc": 1e6, "province": None, "provinces": None, "agency": "X",
                    "work_type": None, "abc_lot_min": None, "abc_lot_max": None,
                    "needs_pcab": None, "id": 1, "matched": []}
        title_hit = mk(10.0, 0.0)      # perfect notice-text match, no attachment
        pdf_hit = mk(0.0, 10.0)        # perfect attachment match, no notice-text match
        pdf_hit["id"] = 2
        out = rank([title_hit, pdf_hit], {"_enabled": False}, 2)
        assert out[0][3]["id"] == 1, \
            "an attachment-only match outranked an exact notice-text match"
        assert out[0][0] > out[1][0] * 1.5, \
            f"attachment weight too high: {out[1][0]} vs {out[0][0]} (DOC_WEIGHT={DOC_WEIGHT})"
        both = mk(10.0, 10.0); both["id"] = 3
        out2 = rank([title_hit, both], {"_enabled": False}, 2)
        assert out2[0][3]["id"] == 3, "matching in BOTH channels must beat matching in one"
        selfcheck.docweight = (f"DOC_WEIGHT={DOC_WEIGHT} TAG_WEIGHT={TAG_WEIGHT}: "
                               f"title-only {out[0][0]} > attachment-only {out[1][0]}")
    check("an attachment match cannot outrank an exact notice-text match", t_doc_weight)

    def t_provenance():
        """Provenance is what makes a cheap model's ranking auditable.  A label that can be wrong
        is worse than no label, so every claimed channel is re-verified against the source."""
        a = _args_for_search(results=12)
        rows, _, _ = run_query(con, "concrete", a, {"_enabled": False})
        hits = rank(rows, {"_enabled": False}, 12)
        assert hits, "no hits to check provenance on"
        assert all(r.get("matched") for _, _, _, r in hits), \
            "a returned hit carried no provenance at all"
        for _, _, _, r in hits:
            for lab in r["matched"]:
                assert lab in PROV_ORDER, f"unknown provenance label {lab!r}"
            if "ttl" in r["matched"]:
                assert "concret" in (r["title"] or "").lower(), \
                    f"claimed a title match but the title is {r['title']!r}"
            if "att" in r["matched"]:
                assert r.get("doc_blob"), "claimed @att with no blob behind it"
        selfcheck.prov = "; ".join(
            f"{r['id']}:{'+'.join(r['matched'])}" for _, _, _, r in hits[:4])
    check("every hit reports where it matched, and the label is true", t_provenance)

    def t_sql_surface():
        """`rfp sql` must reach notices, tags and document text in ONE query -- that is the
        integration.  Also pins the bm25 aggregate workaround documented in SKILL.md: FTS5
        refuses an auxiliary function once the planner flattens a subquery into a GROUP BY, and
        an inner LIMIT is what forces materialisation.  If a future SQLite changes that, this
        fails here instead of in a user's query."""
        if not (s.get("docs_db") and s.get("tags_db")):
            return "SKIPPED (aux DBs absent)"
        r = con.execute("""
            select c.id, (select t.work_type from tags.tags t where t.id = c.id) wt,
                   count(d.doc_id) nd
            from corpus c join docs.documents d
              on d.notice_id = c.id and d.source = c.source
            group by c.id having nd > 3 limit 1""").fetchone()
        assert r and r["wt"] and r["nd"] > 3, f"three-way join returned {tuple(r) if r else None}"
        # the trap, verbatim: no inner LIMIT -> error
        try:
            con.execute("select d.notice_id, min(bm25(doc_fts)) from docs.doc_fts "
                        "join docs.documents d on d.blob_id = doc_fts.rowid "
                        "where doc_fts match 'slump' group by d.notice_id").fetchall()
            trap = False
        except sqlite3.DatabaseError:
            trap = True
        # the documented workaround: inner LIMIT materialises the subquery
        got = con.execute(
            "select notice_id, min(score) from (select d.notice_id, bm25(doc_fts) score "
            "from docs.doc_fts join docs.documents d on d.blob_id = doc_fts.rowid "
            "where doc_fts match 'slump' limit 100000) group by notice_id limit 3").fetchall()
        assert got, "the documented bm25-aggregate workaround returned nothing"
        selfcheck.sqlsurface = (
            f"3-way join ok (notice {r['id']}, {r['wt']}, {r['nd']} docs); "
            f"bm25-in-GROUP-BY {'still errors (workaround needed)' if trap else 'NOW WORKS'}; "
            f"inner-LIMIT workaround ok")
    check("rfp sql joins notices + tags + document text, and the bm25 workaround holds",
          t_sql_surface)

    def t_counts():
        n = con.execute(f"select count(*) from {s['base']}").fetchone()[0]
        assert n > 1000, f"corpus has only {n} notices -- did build run?"
        srcs = dict(con.execute(f"select source, count(*) from {s['base']} group by 1"))
        selfcheck.counts = (n, srcs)
        ids = con.execute(f"select count(distinct id) from {s['base']}").fetchone()[0]
        assert ids == n, "id must be unique -- the two systems' id ranges are disjoint"
        fts = con.execute("select count(*) from corpus").fetchone()[0]
        assert fts == n, f"FTS row count {fts} != notices {n}; index is stale"
    check("corpus row counts and FTS index agree", t_counts)

    _report(ok)
    return 1 if any(v for _, v in ok if v and not str(v).startswith("SKIPPED")) else 0


def _args_for_search(**kw):
    d = dict(query=None, results=10, pool=600, abc_min=None, abc_max=None, strict_abc=False,
             province=None, province_strict=False, work_type=None, mode=None, mode_family=None,
             agency=None, classification=None, source=None, days_min=None, days_max=None,
             closing_before=None, closing_after=None, include_closed=False,
             include_unenriched=False, no_profile=True,
             profile=None, json=False, verbose=False, budget=BUDGET_MEAN, no_snippet=False,
             min_days=None, band=False, no_docs_text=False, no_tag_text=False)
    d.update(kw)
    return argparse.Namespace(**d)


def _report(ok):
    for name, err in ok:
        if err is None:
            print(f"  ok   {name}")
        elif str(err).startswith("SKIPPED"):
            print(f"  skip {name}: {err}")
        else:
            print(f"  FAIL {name}: {err}")
    bad = [n for n, e in ok if e and not str(e).startswith("SKIPPED")]
    for attr, label in (("counts", "corpus"), ("parity", "sql/python parity"), ("docs", "documents"),
                        ("lot", "multi-lot"), ("provinces", "province round-trip"), ("geo", "agency geography"), ("budget", "token budget"),
                        ("facets_tokens", "facets est tokens")):
        if hasattr(selfcheck, attr):
            v = getattr(selfcheck, attr)
            if attr == "budget":
                print("  measured token cost per hit (est):")
                for q, n_, mean, worst in v:
                    print(f"    q={str(q)[:34]:36s} n={n_:3d} mean={mean:5.1f} max={worst:3d}")
            else:
                print(f"  {label}: {v}")
    print(f"{len(ok)-len(bad)}/{len(ok)} checks passed" + (f"  FAILED: {bad}" if bad else ""))


# ---------------------------------------------------------------------------------------------
def add_filters(p):
    p.add_argument("query", nargs="?", default=None,
                   help="FTS5 match expression. Bare words are AND-ed; use OR, "
                        '"quoted phrases", NEAR, prefix*. Omit to rank by profile alone.')
    p.add_argument("--abc-min", type=float, help="peso floor (includes null-ABC notices)")
    p.add_argument("--abc-max", type=float, help="peso ceiling (includes null-ABC and per-lot)")
    p.add_argument("--strict-abc", action="store_true",
                   help="exclude notices with no stated ABC (default: surface and mark them)")
    p.add_argument("--province", action="append",
                   help="province or region name, repeatable/comma-separated; "
                        "matches any of a multi-valued location")
    p.add_argument("--province-strict", action="store_true",
                   help="drop location-null notices (12.2% of corpus)")
    p.add_argument("--work-type", action="append", help=f"one of: {' '.join(WORK_TYPES)}")
    p.add_argument("--mode", help="substring of the exact legal mode (mode_norm)")
    p.add_argument("--mode-family", action="append",
                   help="svp|public_bidding|shopping|negotiated|international|limited_source|"
                        "direct|competitive_dialogue")
    p.add_argument("--agency", help="substring of the procuring entity")
    p.add_argument("--classification", help="the agency's SELF-DECLARED classification")
    p.add_argument("--source", choices=["mphilgeps", "legacy"])
    p.add_argument("--days-min", type=int, help="at least N days to closing")
    p.add_argument("--days-max", type=int, help="at most N days to closing")
    p.add_argument("--closing-before", help="YYYY-MM-DD")
    p.add_argument("--closing-after", help="YYYY-MM-DD")
    p.add_argument("--include-closed", action="store_true")
    p.add_argument("--include-unenriched", action="store_true",
                   help="also show the 12 permanent-HTTP-500 notices (no ABC, no closing date)")
    p.add_argument("--no-profile", action="store_true", help="rank on BM25 alone")
    p.add_argument("--profile", help="path to profile.md (default: alongside rfp)")
    p.add_argument("--pool", type=int, default=600,
                   help="candidates fetched before the profile prior reranks them")
    p.add_argument("--json", action="store_true")


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="rfp", description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="corpus.db location: $RFP_DB, else corpus.db beside this script. "
               "See SKILL.md for the schema and worked queries.")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("sql", help="read-only SQL over corpus.db (the primary tool)")
    p.add_argument("query")
    p.add_argument("--limit", type=int, default=200, help="row cap; 0 = no cap")
    p.add_argument("--cell", type=int, default=140, help="chars per cell in text mode")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_sql)

    p = sub.add_parser("search", help="profile-weighted ranked hits, token-budgeted")
    add_filters(p)
    p.add_argument("-n", "--results", type=int, default=None,
                   help="default: profile `results` (3 contractor / 40 supplier)")
    p.add_argument("--min-days", type=int, help="override profile min_days_to_close (ranking only)")
    p.add_argument("--band", action="store_true",
                   help="also apply the profile abc_band as a filter, not just a prior")
    p.add_argument("--budget", type=int, default=BUDGET_MEAN,
                   help=f"per-hit est-token target; hits trim to fit (default {BUDGET_MEAN}, "
                        f"hard cap {BUDGET_HIT})")
    p.add_argument("--no-snippet", action="store_true")
    p.add_argument("--no-doc-text", dest="no_docs_text", action="store_true",
                   help="ignore attachment text (notice + tag channels only)")
    p.add_argument("--no-tag-text", dest="no_tag_text", action="store_true",
                   help="ignore the distilled scope/keywords channel")
    p.add_argument("-v", "--verbose", action="store_true", help="print the token cost")
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("facets", help="counts by work_type/province/mode/ABC band (~300 tokens)")
    add_filters(p)
    p.set_defaults(fn=cmd_facets, results=1)
    p.set_defaults(pool=30000)

    p = sub.add_parser("show", help="full scope text, line items, attached documents")
    p.add_argument("ids", nargs="+")
    p.add_argument("--chars", type=int, default=4000, help="truncate long text; 0 = all")
    p.add_argument("--no-docs", action="store_true")
    p.add_argument("--doc-text", nargs="?", const="*", metavar="DOC_ID|*",
                   help="print EXTRACTED DOCUMENT TEXT: all attachments, or one doc_id")
    p.add_argument("--doc-chars", type=int, default=6000,
                   help="per-document text cap for --doc-text; 0 = all")
    p.add_argument("--grep", help="with --doc-text, print only matching lines (+/-1 line context)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("reindex", help="(re)build tag_fts in corpus.db from tags.db")
    p.set_defaults(fn=cmd_reindex)

    p = sub.add_parser("build", help="merge tenders.db + legacy.db (+ tags.db) -> corpus.db")
    p.add_argument("--out")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("profile", help="print the resolved profile")
    p.add_argument("--profile")
    p.add_argument("--no-profile", action="store_true")
    p.set_defaults(fn=cmd_profile)

    p = sub.add_parser("stats", help="corpus counts and the measured data hazards")
    p.set_defaults(fn=cmd_stats)

    p = sub.add_parser("selfcheck", help="assert-based tests, no framework")
    p.set_defaults(fn=selfcheck)
    sub.add_parser("test").set_defaults(fn=selfcheck)

    args = ap.parse_args(argv)
    if not getattr(args, "cmd", None):
        ap.print_help()
        return 0
    if args.cmd == "facets":
        args.pool = max(args.pool, 30000)
    return args.fn(args) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
