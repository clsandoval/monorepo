def clean_items(items):
    """Strip the retained table header.  Every mPhilGEPS notice literally contains the words
    'Lot Description', 'Unit of Measure', 'UNSPSC' -- index those and they match every query."""
    if not items:
        return None
    lines = [l.strip() for l in str(items).splitlines()]
    keep = [l for l in lines
            if l and l not in ITEM_HEADER_TOKENS and not re.fullmatch(r"[\d.,]+", l)]
    return "\n".join(keep) or None


