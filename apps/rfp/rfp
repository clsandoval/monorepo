_AGENCY_PROV_RX = None
_NCR_RX = None


def agency_province(agency):
    """Recover geography from the procuring entity's name when `location` is blank.

    Measured on this corpus: `location` is null on 1,929 of 22,068 enriched notices (8.7%), and
    the agency string names a province in 782 of them -- 'DEPARTMENT OF PUBLIC WORKS AND HIGHWAYS
    - BULACAN 1ST DEO'.  Validated against the 19,392 rows where location IS known and
    single-valued: the guess fires on 76.7% of them and agrees 96.3% of the time.

    So it is a RANKING aid, never a filter, and it is displayed with a '~' so nobody mistakes it
    for a stated fact.  The residual 3.7% is mostly not error but meaning: 'DA - LIPA CITY
    BATANGAS' delivering to Quezon is an office in one province procuring for another, which is
    exactly why a stated `location` always wins over this.
    """
    global _AGENCY_PROV_RX, _NCR_RX
    if not agency:
        return None
    if _AGENCY_PROV_RX is None:
        names = sorted({p for ps in REGIONS.values() for p in ps}, key=len, reverse=True)
        _AGENCY_PROV_RX = [(p, re.compile(r"\b" + re.escape(p.upper()).replace(r"\ ", "[ -]")
                                          + r"\b")) for p in names]
        _NCR_RX = re.compile(r"\b(" + "|".join(
            re.escape(c).replace(r"\ ", "[ -]") for c in _NCR_CITIES) + r")\b")
    A = strip_accents(str(agency)).upper()
    for p, rx in _AGENCY_PROV_RX:
        mt = rx.search(A)
        if not mt:
            continue
        if p.upper() in _CITY_TRAP and A[mt.end():mt.end() + 6].lstrip().startswith("CITY"):
            continue
        return p
    return "Metro Manila" if _NCR_RX.search(A) else None


def mode_family(mode_norm):
    m = (mode_norm or "").strip().lower()
    if not m:
        return "unknown"
    for fam, subs in MODE_FAMILIES:
        if any(sub in m for sub in subs):
            return fam
    return "other"


def sql_mode_family(mn):
    parts = [f"when {mn} is null or trim({mn})='' then 'unknown'"]
    for fam, subs in MODE_FAMILIES:
        cond = " or ".join(f"{mn} like '%{s}%'" for s in subs)
        parts.append(f"when {cond} then '{fam}'")
    return "case " + " ".join(parts) + " else 'other' end"


def sql_abc_band(a):
    parts = [f"when {a} is null then 'not stated'"]
    for lo, hi, label in ABC_BANDS:
        if hi is not None:
            parts.append(f"when {a} < {hi} then '{label}'")
    return "case " + " ".join(parts) + f" else '{ABC_BANDS[-1][2]}' end"


