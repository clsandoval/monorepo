    def t_fit():
        prof = {"_enabled": True, "pcab": None, "categories": ["civil_works"],
                "never": ["food_catering"], "abc_band": [200000, 5000000],
                "min_days_to_close": 5, "regions": ["Cavite"], "results": 3}
        want, adj = profile_provinces(prof)
        far = datetime.now().replace(microsecond=0).isoformat()[:11] + "00:00:00"
