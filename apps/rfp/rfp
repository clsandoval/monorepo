def _fake_row(**kw):
    d = {k: None for k in SELECT_COLS + ["rel", "snip"]}
    d.update(kw)
    return d


class _R(dict):
    def keys(self):
        return list(super().keys())


def selfcheck(args):
    ok, n = [], 0

    def check(name, fn):
        nonlocal n
        n += 1
        try:
            fn()
            ok.append((name, None))
        except AssertionError as e:
            ok.append((name, f"ASSERT {e}"))
        except Exception as e:
            ok.append((name, f"{type(e).__name__}: {e}"))

    # --- pure units, no DB needed -----------------------------------------------------------
    def t_mode_family():
        assert mode_family("negotiated procurement - small value procurement (sec. 34)") == "svp", \
            "SVP under a negotiated heading is still SVP (4,228 legacy rows)"
        assert mode_family("competitive bidding (public bidding)") == "public_bidding"
        assert mode_family("international competitive bidding - others") == "international", \
            "ICB must NOT collapse into public bidding -- different procurement rules"
        assert mode_family("shopping - ordinary/regular office supplies & equipment") == "shopping"
        assert mode_family("limited source bidding (sec. 49)") == "limited_source"
        assert mode_family(None) == "unknown" and mode_family("") == "unknown"
    check("mode_family keeps legal modes distinct", t_mode_family)

    def t_locations():
        assert split_locations("Batangas,Laguna,Quezon,Rizal") == \
            ["Batangas", "Laguna", "Quezon", "Rizal"], "comma-multi-valued must split"
        assert split_locations(None) == [] and split_locations("") == []
        assert split_locations("Philippines") == [], "'Philippines' is nationwide, not a province"
        assert split_locations("(Independent City)") == [], "scrape artifact, not a province"
        assert split_locations("Davao de Oro (Compos. Valley)") == ["Davao De Oro"]
        assert split_locations("Metro Manila, Metro Manila") == ["Metro Manila"]
    check("location splits on comma and drops non-provinces", t_locations)

    def t_regions():
        seen = {}
        for r, ps in REGIONS.items():
            for p in ps:
                assert p.lower() not in seen or seen[p.lower()] == r, \
                    f"{p} in two regions: {seen.get(p.lower())} and {r}"
                seen[p.lower()] = r
        want, adj = profile_provinces({"regions": ["NCR", "Cavite", "Laguna"], "_enabled": True})
        assert want == {"metro manila", "cavite", "laguna"}, want
        assert "batangas" in adj and "rizal" in adj, adj
        assert not (want & adj), "adjacency ring must not include the profile's own provinces"
        w2, _ = profile_provinces({"regions": ["Region IV-A"], "_enabled": True})
        assert "quezon" in w2 and len(w2) == 5, w2
    check("region expansion + adjacency", t_regions)

    def t_abc_band():
        assert abc_band(None) == "not stated", "null ABC gets a band, never dropped"
        assert abc_band(0) == "<100K" and abc_band(99_999) == "<100K"
        assert abc_band(100_000) == "100K-500K" and abc_band(1_000_000) == "1M-5M"
        assert abc_band(15_000_000) == "15M-50M" and abc_band(9e9) == "50M+"
    check("abc_band covers null and both extremes", t_abc_band)

    def t_iso():
        assert iso_norm("2026-08-11T14:00") == "2026-08-11T14:00:00", "mPhilGEPS shape"
        assert iso_norm("2026-08-14T14:00:00") == "2026-08-14T14:00:00", "legacy shape"
        assert iso_norm("2026-08-14") == "2026-08-14T00:00:00"
        assert iso_norm(None) is None and iso_norm("") is None and iso_norm("n/a") is None
    check("iso_norm unifies the two systems' timestamps", t_iso)

    def t_days():
        assert days_to(None) is None, "12 zombie notices carry no closing date"
