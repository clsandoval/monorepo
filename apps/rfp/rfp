    def t_agency_province():
        """The agency-name fallback is only allowed to exist because it was measured.  This
        re-measures it every run against the rows where `location` IS known, so a regression in
        the pattern list shows up as a number, not as quietly worse ranking."""
        assert agency_province("DEPARTMENT OF PUBLIC WORKS AND HIGHWAYS - BULACAN 1ST DEO") \
            == "Bulacan"
        assert agency_province("CITY OF PASAY") == "Metro Manila"
        assert agency_province("QUEZON CITY GOVERNMENT") == "Metro Manila", \
            "Quezon City is in Metro Manila, not Quezon province"
        assert agency_province("PROVINCE OF QUEZON") == "Quezon"
        assert agency_province("BRGY. COMMUNAL, DAVAO CITY, DAVAO DEL SUR") == "Davao Del Sur"
        assert agency_province("DEPARTMENT OF BUDGET AND MANAGEMENT") is None
        assert agency_province(None) is None and agency_province("") is None

        b = s["base"]
        rows_ = con.execute(
            f"select agency, location from {b} where {expr(s,'enriched_at')} is not null "
            f"and location is not null and trim(location) <> '' "
            f"and location not like '%,%'").fetchall()
        agree = dis = noguess = 0
        for r in rows_:
            truth = canon_province(r["location"])
            if truth is None:
                continue
            g = agency_province(r["agency"])
            if g is None:
                noguess += 1
            elif g.lower() == truth.lower():
                agree += 1
            else:
                dis += 1
        prec = 100.0 * agree / max(1, agree + dis)
        assert prec >= 93.0, f"agency-province precision fell to {prec:.1f}% (was 96.5%)"
        nul = con.execute(f"select agency from {b} where {expr(s,'enriched_at')} is not null "
                          f"and (location is null or trim(location) = '')").fetchall()
        rec = sum(1 for r in nul if agency_province(r["agency"]))
        assert nul and rec / len(nul) >= 0.40, \
            f"recovers only {rec}/{len(nul)} of the location-null rows (was 48.8%)"
        selfcheck.geo = (f"precision {prec:.1f}% on {agree+dis} guesses "
                         f"({noguess} no-guess); recovers {rec}/{len(nul)} "
                         f"({100.0*rec/len(nul):.1f}%) of location-null rows")
    check("agency-name geography: precision and recovery still hold", t_agency_province)

