# ---------------------------------------------------------------------------------------------
# Attachment text: a SECOND index, joined by notice id.  Not merged into corpus_fts.
#
# The decision and the three measurements that force it (2026-08-08):
#
#  1. LENGTH ASYMMETRY, 46x.  Median notice that has attachments carries 154,571 chars of
#     extracted document text against a 3,333-char mean notice body.  BM25 length-normalises,
#     but one index means one term-frequency space, and the tail wags the dog: a 200-page ITB
#     that says "generator" forty times in a boilerplate spec annex would outrank a notice
#     TITLED "Supply and Delivery of One (1) Generator Set".  That is precisely backwards.
#  2. STRUCTURAL SOURCE BIAS.  17,795 of 22,080 notices (80.6%) can never carry attachment
#     text, because legacy's document listing is auth-gated (NOTES-extract.md: the doc_view
#     endpoint answers 200 with a "session has been expired" shell).  Merged into one index,
#     any attachment-flavoured query silently becomes an mPhilGEPS-only query -- the failure-by-
#     omission class this corpus punishes hardest, and invisible to the reader.
#  3. PROVENANCE IS UNRECOVERABLE ONCE MERGED.  One index cannot say whether 'backhoe' came
#     from the title or from page 47 of an annex.  Ranking a cheap model can audit is the whole
#     point, so the two scores must stay separable to the end.
#
# So: docs.db keeps its blob-level `doc_fts` (8,337 rows, external-content over blobs), corpus.db
# keeps `corpus_fts`, and `rfp` ATTACHes both read-only and combines the two scores in Python
# with an explicit weight.  Nothing is copied: duplicating 554.8M chars of document text into
# corpus.db would cost ~500MB and a rebuild step to buy a strictly worse ranking.
#
# DOC_WEIGHT is the cap on how much an attachment-only match can be worth relative to a perfect
# notice-text match.  At 0.45 an attachment hit can carry a notice into the results (which is the
# feature -- the scope lives in the PDF) but cannot displace a strong title match (the failure
# mode named in the brief).  Verified by selfcheck t_doc_weight.
DOC_WEIGHT = 0.45
# The distilled tag text (scope/keywords) is one curated sentence per notice -- high precision,
# no bulk problem -- so it is trusted more per match than an attachment, but still less than the
# notice's own title.
TAG_WEIGHT = 0.60
# doc_fts columns are (text, names).  The human filename is short and highly diagnostic
# ("BILL OF QUANTITIES.pdf"), so it is weighted well above the body text per character.
DOC_FTS_WEIGHTS = (1.0, 4.0)
# Cap on blobs scored per query.  'the OR and OR of' matches 5,908 blobs in 0.215s, so this is a
# guard against pathological queries, not a routine limit.
DOC_MATCH_CAP = 12000

