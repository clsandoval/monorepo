def cmd_reindex(args):
    """Build `tag_fts` inside corpus.db from tags.db.

    The one thing here that writes.  It is a separate subcommand rather than part of `build`
    because `build` merges the two ingests and takes minutes, while this reads 22,068 short rows
    and takes about a second -- and the tag pass reruns far more often than the ingest does.

    Contents are the distilled fields only (scope, keywords, deliverables).  Deliberately NOT the
    notice body: that is already in corpus_fts, and indexing it twice would double-count it in
    the combined score for no recall gain."""
    p = db_path()
    if not p.exists():
        die(f"{p} not found; run `rfp build` first")
    if not SRC_TAGS.exists():
        die(f"{SRC_TAGS} not found; nothing to index")
    con = sqlite3.connect(str(p))
    con.execute("attach database ? as tags", (f"file:{SRC_TAGS}?mode=ro",))
    t0 = time.time()
    con.executescript("""
        drop table if exists tag_fts;
        create virtual table tag_fts using fts5(
          scope, keywords, deliverables,
          tokenize="porter unicode61 remove_diacritics 2"
        );
    """)
    # rowid = notice id, so every join in the search path is `tag_fts.rowid = corpus.id` and no
    # second mapping table has to be kept in step.
    n = con.execute("""
        insert into tag_fts(rowid, scope, keywords, deliverables)
        select t.id, coalesce(t.scope,''), coalesce(t.keywords,''), coalesce(t.deliverables,'')
        from tags.tags t
        where exists (select 1 from corpus c where c.id = t.id)
    """).rowcount
    con.execute("insert into tag_fts(tag_fts) values('optimize')")
    con.commit()
    orphan = con.execute(
        "select count(*) from corpus c where not exists "
        "(select 1 from tag_fts f where f.rowid = c.id)").fetchone()[0]
    con.close()
    print(f"tag_fts: {n} rows indexed in {time.time()-t0:.1f}s ({orphan} corpus rows untagged)")
    return 0


def cmd_sql(args):
    q = args.query.strip().rstrip(";").strip()
    low = q.lower()
    if not re.match(r"^(select|with|explain|pragma table_info|pragma table_list)\b", low):
        die("sql accepts read statements only (select / with / explain / pragma table_info). "
            "corpus.db is opened read-only, so a write would error anyway -- this message is "
            "just the faster error.")
    if ";" in q:
        die("one statement per call (a ';' was found)")
    con = connect()
    try:
        cur = con.execute(q)
        rows = cur.fetchmany(args.limit + 1) if args.limit else cur.fetchall()
    except sqlite3.DatabaseError as e:
        die(f"{type(e).__name__}: {e}", 1)
    names = [d[0] for d in (cur.description or [])]
    truncated = bool(args.limit) and len(rows) > args.limit
    rows = rows[:args.limit] if args.limit else rows
    if args.json:
        print(json.dumps([{n: r[n] for n in names} for r in rows], indent=1, default=str))
    else:
        if names:
            print(" | ".join(names))
        for r in rows:
            print(" | ".join("" if r[n] is None else norm_ws(str(r[n]))[:args.cell]
                             for n in names))
        print(f"({len(rows)} rows{'; TRUNCATED, raise --limit' if truncated else ''})")
    return 0


