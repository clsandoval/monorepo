def cmd_stats(args):
    """Every number SKILL.md quotes comes from here, so it can be re-measured, not trusted."""
    con = connect()
    s = schema(con)
    b = s["base"]
    for mt in ("build_meta", "meta"):
        if mt in s["tables"]:
            kc, vc = s["tables"][mt][0], s["tables"][mt][1]
            for r in con.execute(f"select {kc},{vc} from {mt} order by {kc}"):
                v = str(r[1])
                print(f"{r[0]}: {v if len(v) < 110 else v[:107] + '...'}")
            break
    print(f"schema: base={b} fts={s['fts']}(key={s['fts_key']}) "
          f"locations={(s['prov'] or {}).get('table')}")
    enr = f" where {expr(s,'enriched_at')} is not null" if "enriched_at" in s["cols"] else ""
    n = con.execute(f"select count(*) from {b}{enr}").fetchone()[0]
    raw = con.execute(f"select count(*) from {b}").fetchone()[0]
    print(f"notices: {n} enriched of {raw} rows ({raw-n} unenriched: the permanent-500 zombies)")
    ca, mf = expr(s, "closing_at"), expr(s, "mode_family")
    dow = expr(s, "closing_dow")
    q = lambda w: f"select count(*) from {b}{enr or ' where 1=1'} and ({w})"  # noqa: E731
    for label, sql in [
        ("value", f"select sum(abc) from {b}{enr}"),
        ("abc null", q("abc is null")),
        ("location null", q("location is null or trim(location)=''")),
        ("closing null", q(f"{ca} is null")),
        ("untagged (work_type null)", q(f"{expr(s,'work_type')} is null")),
        ("multi-lot", q("abc_lot_min is not null and abc_lot_max > abc_lot_min")
         if "abc_lot_min" in s["cols"] else None),
        ("closes <=6d", q(f"{ca} is not null and julianday({ca})-julianday('now') between 0 and 6")),
        ("closes <=2d", q(f"{ca} is not null and julianday({ca})-julianday('now') between 0 and 2")),
        ("deadline Mon or Tue", q(f"{dow} in (1,2)")),
        ("deadline Mon/Tue before noon", q(f"{dow} in (1,2) and cast(substr({ca},12,2) as int)<12")),
        ("public bidding", q(f"({mf})='public_bidding'")),
        ("svp", q(f"({mf})='svp'")),
        ("dupe_key groups >1", f"select count(*) from (select dupe_key from {b}{enr} "
                               f"group by 1 having count(*)>1)"),
    ]:
        if sql is None:
            continue
        try:
            v = con.execute(sql).fetchone()[0] or 0
            print(f"{label}: {peso(v) if label == 'value' else v}"
                  + (f"  ({100.0*v/n:.1f}%)" if label != "value" and n else ""))
        except sqlite3.DatabaseError as e:
            print(f"{label}: n/a ({e})")
    return 0


