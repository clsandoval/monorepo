def docs_for(ids, want_text=False):
    """Attached bid documents for a set of notice ids.

    Returns (docs_by_notice_id, crawl_status_by_notice_id, note).

    'This notice has no attachments' and 'this notice was never crawled for attachments' are
    different answers and the caller must be able to tell them apart.  docs.db covers the 4,285
    mPhilGEPS notices only -- legacy's document listing is auth-gated (NOTES-extract.md: the
    doc_view endpoint answers HTTP 200 with a 'session has been expired' shell, so there is
    nothing to fetch without a supplier login, and we do not have one).  Reporting 17,795 legacy
    notices as 'no documents' would be a lie the reader cannot detect.

    `want_text` is off by default: the median attached document is 56,276 chars and a notice
    carries up to 40 of them, so text is fetched only when someone asks to read it.
    """
    empty = ({}, {}, "docs.db not present (attached bid documents not ingested)")
    if not DOCS_DB.exists():
        return empty
    if not ids:
        return {}, {}, "no ids"
    try:
        con = sqlite3.connect(f"file:{DOCS_DB}?mode=ro", uri=True)
        con.row_factory = sqlite3.Row
    except sqlite3.DatabaseError as e:
        return {}, {}, f"docs.db unreadable: {e}"
    try:
        ph = ",".join("?" * len(ids))
        text_sel = "b.text as text," if want_text else "null as text,"
        docs = {}
        for r in con.execute(f"""
                select d.notice_id as nid, d.doc_id, d.source, d.url,
                       coalesce(d.human_name, d.filename) as name,
                       d.member_path, d.parent_doc_id, d.seq, d.uploaded, d.is_supplement,
                       d.blob_id, d.sha256, d.bytes, d.fmt,
                       d.extract_status, d.extract_note,
                       coalesce(d.chars, b.chars) as chars,
                       b.pages, b.text_pages, b.scan_pages, b.sheets,
                       {text_sel}
                       b.names as blob_names
                from documents d left join blobs b on b.blob_id = d.blob_id
                where d.notice_id in ({ph})
                order by d.notice_id, coalesce(d.seq, 9999), d.doc_id""", list(ids)):
            docs.setdefault(r["nid"], []).append({k: r[k] for k in r.keys()})
        status = {}
        for r in con.execute(
                f"select notice_id as nid, status, n_docs, http_status, fetch_errors "
                f"from notices where notice_id in ({ph})", list(ids)):
            status[r["nid"]] = {k: r[k] for k in r.keys()}
        tot, cov = con.execute(
            "select (select count(*) from documents), (select count(*) from notices)").fetchone()
        note = (f"docs.db: {tot} documents across {cov} crawled notices; "
                f"mPhilGEPS only -- legacy document listings are auth-gated, so absence here is "
                f"NOT absence of attachments")
        return docs, status, note
    except sqlite3.DatabaseError as e:
        return {}, {}, f"docs.db query failed: {e}"
    finally:
        con.close()


def doc_text_for(doc_ids):
    """Extracted text for specific doc_ids.  Separate from docs_for so listing never pays for
    text: one blob can be 2.27M chars."""
    if not DOCS_DB.exists() or not doc_ids:
        return {}
    try:
        con = sqlite3.connect(f"file:{DOCS_DB}?mode=ro", uri=True)
    except sqlite3.DatabaseError:
        return {}
    try:
        ph = ",".join("?" * len(doc_ids))
        return {int(r[0]): (r[1] or "") for r in con.execute(
            f"select d.doc_id, b.text from documents d left join blobs b "
            f"on b.blob_id = d.blob_id where d.doc_id in ({ph})", list(doc_ids))}
    except sqlite3.DatabaseError:
        return {}
    finally:
        con.close()


def grep_text(text, pattern, ctx=1, cap=40):
    """Matching lines (+/- ctx) from a document, for --grep.  A 200-page ITB has one paragraph
    you care about; printing the other 199 pages to find it defeats the purpose."""
    try:
        rx = re.compile(pattern, re.I)
    except re.error as e:
        return [f"(bad --grep regex: {e})"]
    lines = [ln.rstrip() for ln in text.splitlines()]
    keep = set()
    for i, ln in enumerate(lines):
        if rx.search(ln):
            keep.update(range(max(0, i - ctx), min(len(lines), i + ctx + 1)))
    if not keep:
        return []
    out, prev = [], None
    for i in sorted(keep):
        if prev is not None and i > prev + 1:
            out.append("    ...")
        s = norm_ws(lines[i])
        if s:
            out.append(f"    {i+1}: {s[:300]}")
        prev = i
        if len(out) >= cap:
            out.append(f"    ... (truncated at {cap} lines; tighten --grep)")
            break
    return out


def cmd_show(args):
    con = connect()
    s = schema(con)
    ids = [int(x) for a in args.ids for x in str(a).replace(",", " ").split()]
    sel = ", ".join(f"{col(s,c)} as {c}" for c in SELECT_COLS + [
        "description", "items", "contact", "contact_email", "contact_phone", "funding",
        "control", "lot_type", "client_agency", "downloads", "closing_detail", "last_updated",
        "solicitation_no", "trade_agreement", "bid_supplements", "doc_req_list", "dupe_key",
        "enriched_at", "publish"])
    ph = ",".join("?" * len(ids))
    rows = con.execute(f"select {sel} from {s['base']} where {s['base']}.id in ({ph})",
                       ids).fetchall()
    found = {r["id"] for r in rows}
    want_text = getattr(args, "doc_text", None) or (("*" if args.grep else None)
                                                    if hasattr(args, "grep") else None)
    docs, dstat, docnote = docs_for(ids) if not args.no_docs else ({}, {}, "docs suppressed")
    # Text is fetched in a second pass, for the requested documents only.  The median blob is
    # 56,276 chars and the largest is 2.27M, so `show` must never pull text it will not print.
    dtext = {}
    if want_text and not args.no_docs:
        ids_w = [d["doc_id"] for dl in docs.values() for d in dl
                 if want_text == "*" or str(d["doc_id"]) == str(want_text)]
        dtext = doc_text_for(ids_w)

    if args.json:
        out = []
        for r in rows:
            d = {k: r[k] for k in r.keys()}
            d["days"] = days_to(r["closing_at"])
            d["items"] = clean_items(r["items"])
            d["documents"] = docs.get(r["id"], [])
            d["doc_crawl"] = dstat.get(r["id"])
            out.append(d)
        print(json.dumps({"found": out, "missing": [i for i in ids if i not in found],
                          "docs": docnote}, indent=1, default=str))
        return 0

    for r in rows:
        print("=" * 78)
        print(f"[{r['id']}] {norm_ws(r['title'])}")
        print(f"  {r['agency']}"
              + (f"  (for {r['client_agency']})" if r["client_agency"] else ""))
        abc_line = f"  ABC {peso(r['abc'])}"
        if r["abc"] is None:
            abc_line += "  <- NOT STATED on the notice (real: 39 rows do this, not a parse bug)"
        lot = lots_str(r)
        if lot:
            abc_line += f"   {lot}"
        print(abc_line)
        print(f"  closes {r['closing'] or r['closing_at'] or '(no date)'}"
              f"  [{days_str(r['closing_at'])}]   published {r['publish'] or r['publish_at']}")
        print(f"  mode {r['mode']}  ({r['mode_family']})   classification {r['classification']}"
              f"   category {r['category']}")
        print(f"  location {r['location'] or '(null -- 12.2% of the corpus)'}"
              + (f"   parsed: {r['provinces']}" if r["provinces"] else ""))
        tagline = f"  work_type {r['work_type'] or '(untagged)'}   needs_pcab {r['needs_pcab']}"
        print(tagline)
        if r["eligibility"]:
            try:
                el = json.loads(r["eligibility"])
            except Exception:
                el = [r["eligibility"]]
            if el:
                print("  eligibility beyond the universal four: " + "; ".join(str(x) for x in el))
        if r["scope"]:
            print(f"  scope: {r['scope']}")
        for label, key in (("solicitation", "solicitation_no"), ("status", "status"),
                           ("delivery", "delivery"), ("funding", "funding"),
                           ("control", "control"), ("trade agreement", "trade_agreement")):
            if r[key]:
                print(f"  {label}: {r[key]}")
        if r["contact"]:
            print(f"  contact: {norm_ws(r['contact'])[:300]}")
        print(f"  url {r['url']}")
        print("  --- description " + "-" * 55)
        desc = (r["description"] or "(empty)")
        if args.chars and len(desc) > args.chars:
            desc = desc[:args.chars] + f"\n  [... {len(r['description'])-args.chars} more chars; "\
                                       f"--chars 0 for all]"
        print(desc)
        items = clean_items(r["items"])
        if items:
            print("  --- line items (table header stripped) " + "-" * 32)
            it = items
            if args.chars and len(it) > args.chars:
                it = it[:args.chars] + f"\n  [... {len(items)-args.chars} more chars; " \
                                       f"--chars 0 for all]"
            print(it)
        dl = docs.get(r["id"], [])
        st = dstat.get(r["id"])
        print(f"  --- documents ({len(dl)}) " + "-" * 50)
        if not dl:
            # 'no documents' and 'never looked' are different answers.  Say which.
            if st:
                print(f"  crawled: status={st.get('status')} n_docs={st.get('n_docs')} "
                      f"http={st.get('http_status')} -- no attachments recorded")
            else:
                print(f"  NOT CRAWLED for attachments. {docnote}")
            if r["downloads"]:
                print(f"  the notice page's own download count: {r['downloads']}")
            if r["bid_supplements"] is not None or r["doc_req_list"] is not None:
                print(f"  bid_supplements={r['bid_supplements']} "
                      f"doc_req_list={r['doc_req_list']}")
        for d in dl:
            meta = " ".join(f"{k}={d[k]}" for k in ("fmt", "bytes", "pages", "chars",
                                                    "extract_status")
                            if d.get(k) not in (None, ""))
            sup = " [SUPPLEMENT: uploaded after posting]" if d.get("is_supplement") else ""
            inside = f" (inside {d['member_path']})" if d.get("member_path") else ""
            print(f"  #{d['doc_id']} {d.get('name')}{inside}  {meta}{sup}")
            if d.get("scan_pages"):
                print(f"      {d['scan_pages']} image-only page(s): text is partial "
                      f"(no OCR was run)")
            if not d.get("chars") and d.get("extract_note"):
                print(f"      no text: {d['extract_note']}")
        if dl and not want_text:
            print(f"  (text not shown; `rfp show {r['id']} --doc-text` for all, "
                  f"`--doc-text <doc_id>` for one, `--grep PATTERN` to search inside)")

        # --- extracted document text, on request only ---------------------------------------
        for d in dl if want_text else []:
            if want_text != "*" and str(d["doc_id"]) != str(want_text):
                continue
            t = dtext.get(d["doc_id"]) or ""
            if not t.strip():
                print(f"  --- #{d['doc_id']} {d.get('name')}: NO TEXT "
                      f"({d.get('extract_status')}: {d.get('extract_note') or '-'})")
                continue
            print(f"  --- #{d['doc_id']} {d.get('name')} "
                  f"({len(t):,} chars) " + "-" * 24)
            if args.grep:
                hits = grep_text(t, args.grep)
                print("\n".join(hits) if hits else f"    (no line matches {args.grep!r})")
            else:
                cap = args.doc_chars
                print("    " + norm_ws(t[:cap] if cap else t).replace("\n", "\n    ")
                      + (f"\n    [... {len(t)-cap:,} more chars; --doc-chars 0 for all]"
                         if cap and len(t) > cap else ""))
    for i in ids:
        if i not in found:
            print(f"[{i}] not in corpus (unenriched, retired at fetch_errors=3, or wrong id)")
    return 0


