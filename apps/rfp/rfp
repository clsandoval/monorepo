  solicitation_no text, trade_agreement text,
  delivery      text, status text, funding text, control text,
  lot_type      text, client_agency text,
  contact       text, contact_email text, contact_phone text,
  downloads     text, closing_detail text, last_updated text,
  bid_supplements integer, doc_req_list integer,
  description   text,
