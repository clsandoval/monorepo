def die(msg, code=2):
    print(f"rfp: {msg}", file=sys.stderr)
    sys.exit(code)


def est_tokens(s):
    """Estimated tokens.  tiktoken is not installed and this tool must not grow a dependency to
    print a number, so: 1 token per 3.5 characters, floored by word count.  Deliberately
    pessimistic -- the corpus is ALLCAPS-heavy agency names, which tokenize worse than prose, so
    a real tokenizer should come in at or under this.  Every token figure this tool prints or
    asserts on is this estimate; it is a budget guard, not an invoice.
    """
    if not s:
        return 0
    return max(int(len(s) / 3.5 + 0.5), len(s.split()))


def peso(v):
    if v is None:
        return "n/s"
    v = float(v)
    if v >= 1e9:
        return f"P{v/1e9:.2f}B".replace(".00B", "B")
    if v >= 1e6:
        return f"P{v/1e6:.1f}M".replace(".0M", "M")
    if v >= 1e3:
        return f"P{v/1e3:.0f}K"
    return f"P{v:.0f}"


def norm_ws(s):
    return re.sub(r"\s+", " ", (s or "")).strip()


def strip_accents(s):
    return "".join(c for c in unicodedata.normalize("NFKD", s or "") if not unicodedata.combining(c))


def canon_province(tok):
    t = norm_ws(strip_accents(tok)).lower()
    if t in NON_PROVINCE:
        return None
    if t in _CANON:
        return _CANON[t]
    t2 = re.sub(r"\s*\(.*?\)\s*", "", t).strip()          # 'Davao de Oro (Compos. Valley)'
    if t2 in _CANON:
        return _CANON[t2]
    return norm_ws(tok)                                    # unknown token: keep, don't drop


def split_locations(loc):
    if not loc:
        return []
    out, seen = [], set()
    for part in str(loc).split(","):
        p = canon_province(part)
        if p and p.lower() not in seen:
            seen.add(p.lower())
            out.append(p)
    return out


def province_variants(name):
    """Every spelling of one province that appears in either corpus.  The two ingests and the
    merge each normalise differently -- 'North Cotabato' is stored with location_norm
    'COTABATO', 'Tawi-Tawi' as 'TAWI TAWI', 'Dinagat Island' as 'DINAGAT ISLANDS',
    'Davao de Oro (Compos. Valley)' as 'DAVAO DE ORO'.  A province filter that knows one
    spelling silently misses the rows stored under the other."""
    n = norm_ws(strip_accents(str(name))).upper()
    out = {n}
    out.add(re.sub(r"\s*\(.*?\)\s*", " ", n).strip())
    out.add(n.replace("-", " "))
    out.add(n.replace(" ", "-"))
    for a, b in (("NORTH COTABATO", "COTABATO"), ("DINAGAT ISLAND", "DINAGAT ISLANDS"),
                 ("DAVAO DE ORO", "COMPOSTELA VALLEY"),
                 ("MAGUINDANAO", "MAGUINDANAO DEL NORTE"),
                 ("MAGUINDANAO", "MAGUINDANAO DEL SUR")):
        if n == a:
            out.add(b)
        if n == b:
            out.add(a)
    return {norm_ws(x) for x in out if norm_ws(x)}


