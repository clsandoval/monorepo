                                        ).isoformat()))
        f_good, n_good = profile_fit(good, prof, want, adj)
        assert f_good == 1.0 and n_good == [], (f_good, n_good)

        big = _R(dict(good, abc=40e6))
        f_big, n_big = profile_fit(big, prof, want, adj)
        assert f_big < f_good and any("stretch" in x for x in n_big), (f_big, n_big)
        assert n_big[0] == "stretch: P40M vs your P5M band", n_big
        # ^ the annotation is the point: S3 says demote and TELL, never hide.
        assert f_big >= 0.20, "fit is a prior: never zero, never a hard filter"

        nullabc = _R(dict(good, abc=None))
        f_n, n_n = profile_fit(nullabc, prof, want, adj)
        assert any("not stated" in x for x in n_n) and f_n > 0.2, (f_n, n_n)

        lot = _R(dict(good, abc=360000.0, abc_lot_min=60000.0, abc_lot_max=60000.0))
        prof2 = dict(prof, abc_band=[10000, 100000])
        f_l, n_l = profile_fit(lot, prof2, want, adj)
        assert f_l > 0.9 and any("lot fits" in x for x in n_l), (f_l, n_l)
        f_tot, _ = profile_fit(_R(dict(good, abc=360000.0)), prof2, want, adj)
        assert f_l > f_tot, "a notice whose LOT fits must outrank the same total with no lots"

        adjr = _R(dict(good, provinces="Batangas", province="Batangas"))
        f_a, n_a = profile_fit(adjr, prof, want, adj)
        outr = _R(dict(good, provinces="Cebu", province="Cebu"))
        f_o, _ = profile_fit(outr, prof, want, adj)
        nullp = _R(dict(good, provinces=None, province=None))
        f_p, n_p = profile_fit(nullp, prof, want, adj)
        assert f_good > f_a > f_o, (f_good, f_a, f_o)
        assert f_p > f_o, "location-null must not be punished harder than a real mismatch"
        assert any("adjacent" in x for x in n_a) and any("not stated" in x for x in n_p)

        from datetime import timedelta
        tight = _R(dict(good, closing_at=(datetime.now() + timedelta(days=2, hours=6))
                        .replace(microsecond=0).isoformat()))
        f_t, n_t = profile_fit(tight, prof, want, adj)
        assert f_t < f_good and any("tight" in x for x in n_t), (f_t, n_t)
        assert f_t > 0.2, "23.2% of the board closes in <=48h; tight is a demotion, not a drop"
        closed = _R(dict(good, closing_at=(datetime.now() - timedelta(days=3)).isoformat()))
        f_cl, n_cl = profile_fit(closed, prof, want, adj)
        assert f_cl < f_t and n_cl == ["CLOSED"], (f_cl, n_cl)

        nev = _R(dict(good, work_type="food_catering"))
        f_v, n_v = profile_fit(nev, prof, want, adj)
        assert f_v <= 0.35 and any("never" in x for x in n_v)
        assert f_v > 0.0, "even `never` is a demotion -- S3: nothing is hidden"

        untag = _R(dict(good, work_type=None))
        f_u, n_u = profile_fit(untag, prof, want, adj)
        assert f_good > f_u > 0.8, (f_u, "untagged is a soft penalty; most rows are untagged")

        off = _R(dict(good, needs_pcab=1))
        f_c, n_c = profile_fit(off, prof, want, adj)
        assert f_c < f_good and any("PCAB" in x for x in n_c)

        worst = _R(_fake_row(work_type="food_catering", abc=900e6, provinces="Sulu",
                             province="Sulu", needs_pcab=1, closing_at=None))
        f_w, _ = profile_fit(worst, prof, want, adj)
        assert f_w == 0.20, f"floor must hold at 0.20, got {f_w}"
        assert profile_fit(good, {"_enabled": False}, want, adj) == (1.0, []), \
            "--no-profile must be a true bypass"
    check("profile_fit is a prior: demotes+annotates, floors at 0.20, never hides", t_fit)

