-item pricing-feature-item-dark"},["SPAN",{"class":"pricing-bullet"}],"Priority email support (48hr response)"],["LI",{"class":"pricing-feature-item pricing-feature-item-dark"},["SPAN",{"class":"pricing-bullet"}],"Dashboard analytics (bot activity overview)"],["LI",{"class":"pricing-feature-item pricing-feature-item-dark"},["SPAN",{"class":"pricing-bullet"}],"Connection health monitoring"],["LI",{"class":"pricing-feature-item pricing-feature-item-dark"},["SPAN",{"class":"pricing-bullet"}],"30-day audit log"]]],["DIV",{"class":"pricing-card pricing-card-light"},["H3",{"class":"pricing-plan-name-light"},"Pro"],["DIV",{"class":"pricing-price-row"},["SPAN",{"class":"pricing-price-light font-headline-expanded"},"$29"],["SPAN",{"class":"pricing-price-period-light"},"/ month"]],["P",{"class":"pricing-price-desc-light"},"For teams and power users."],["HR",{"class":"pricing-card-divider-light"}],["A",{"href":"/signup","class":"pricing-cta-secondary"},"Start Pro Plan"],["HR",{"class":"pricing-card-divider-light"}],["P",{"class":"pricing-feature-heading-light"},"What's included"],["UL",{"class":"pricing-feature-list"},["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"Everything in Starter"],["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"Up to 5 Discord connections (multi-server)"],["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"Team members (up to 5)"],["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"Priority support (24hr, dedicated Slack channel)"],["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"Advanced analytics (usage by tool, by user)"],["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"90-day audit log"],["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"Custom bot name configuration (future)"],["LI",{"class":"pricing-feature-item pricing-feature-item-light"},["SPAN",{"class":"pricing-bullet"}],"Early access to new integrations"]]]],["DIV",{"class":"pricing-byok-wrap"},["DIV",{"class":"pricing-byok-note"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-info pricing-byok-icon","aria-hidden":"true"},["circle",{"cx":"12","cy":"12","r":"10"}],["path",{"d":"M12 16v-4"}],["path",{"d":"M12 8h.01"}]],["P",{"class":"pricing-byok-text"},["STRONG",{},"How BYOK pricing works"],": Daimon charges only the platform fee above. Your bot's AI usage (Claude API calls) is billed directly from Anthropic to your API key. You keep full visibility and control over your AI spending."]]]]]],["SECTION",{"id":"faq","aria-label":"FAQ","style":"scroll-margin-top:80px"},["STYLE",{},"\n        .faq-root {\n          background-color: #FFFFFF;\n          padding: 96px 0;\n        }\n        .faq-container {\n          max-width: 896px;\n          margin: 0 auto;\n          padding: 0 32px;\n        }\n        .faq-section-label {\n          font-size: 12px;\n          font-weight: 600;\n          text-transform: uppercase;\n          letter-spacing: 0.1em;\n          color: rgba(12, 31, 64, 0.5);\n          margin-bottom: 12px;\n          font-family: var(--font-body);\n          text-align: center;\n        }\n        .faq-heading {\n          font-size: clamp(28px, 3.5vw, 44px);\n          font-weight: 500;\n          color: #0C1F40;\n          text-align: center;\n          margin-bottom: 48px;\n        }\n        .faq-item {\n          border-bottom: 1px solid rgba(12, 31, 64, 0.08);\n        }\n        .faq-question-btn {\n          width: 100%;\n          display: flex;\n          align-items: center;\n          justify-content: space-between;\n          padding: 20px 0;\n          background: none;\n          border: none;\n          cursor: pointer;\n          text-align: left;\n          gap: 16px;\n        }\n        .faq-question-text {\n          font-size: 17px;\n          font-weight: 500;\n          color: #0C1F40;\n          font-family: var(--font-body);\n          line-height: 1.4;\n        }\n        .faq-expand-icon {\n          font-size: 20px;\n          font-weight: 400;\n          color: rgba(12, 31, 64, 0.6);\n          flex-shrink: 0;\n          line-height: 1;\n          width: 20px;\n          text-align: center;\n        }\n        .faq-answer {\n          overflow: hidden;\n          transition: max-height 0.3s ease;\n        }\n        .faq-answer-inner {\n          padding: 0 0 20px 0;\n          font-size: 16px;\n          font-weight: 400;\n          color: rgba(12, 31, 64, 0.7);\n          line-height: 1.7;\n          font-family: var(--font-body);\n        }\n        @media (max-width: 900px) {\n          .faq-container { padding: 0 24px; }\n          .faq-root { padding: 60px 0; }\n          .faq-question-text { font-size: 16px; }\n          .faq-answer-inner { font-size: 15px; }\n        }\n      "],["DIV",{"class":"faq-root"},["DIV",{"class":"faq-container"},["P",{"class":"faq-section-label"},"FAQ"],["H2",{"class":"faq-heading font-headline-semi-expanded"},"Common questions."],["DIV",{},["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"Do I need to host my own bot?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"No. Daimon runs the bot infrastructure for you on Fly.io. You bring your Discord bot token (which you create once in the Discord Developer Portal) — Daimon handles the rest. Your bot stays online 24/7 without you managing servers."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"What is BYOK (Bring Your Own Keys)?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"BYOK means you provide your own Anthropic API key. When your bot responds to messages in Discord, the AI processing cost goes directly to your Anthropic account. Daimon only charges the small platform fee listed above — we never add a markup to your AI usage."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"How do I create a Discord bot token?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"Go to discord.com/developers/applications, create a new application, navigate to the \"Bot\" section, and click \"Reset Token\" to generate your token. Enable the \"Message Content\" intent under Privileged Gateway Intents. Copy the token. Also copy your server's ID (right-click your server icon → Copy Server ID). Paste both into your Daimon dashboard. Our Quick Start guide has step-by-step screenshots."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"Is my bot token stored securely?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"Yes. Your Discord bot token and API keys are encrypted at rest using Supabase Vault (AES-256 encryption). They are never returned in API responses or logs. Daimon staff cannot view your credentials."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"What services can my bot use?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"All 50+ tools are available to every tier. You connect your own accounts for each service (GitHub, Google, Linear, Toggl, Notion, Slack, etc.) and the tools activate. Services you haven't connected simply won't be used."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"Can I use my own OpenAI key?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"Optionally. Daimon uses Claude (Anthropic) as the primary AI model. Some classification tasks can optionally use OpenAI — if you paste an OpenAI key, it will be used for those tasks. An OpenAI key is not required."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"What happens if my Anthropic API key runs out of credits?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"The bot will stop responding to messages and Daimon will mark your API key as invalid. Your dashboard will show an error state on the \"API Keys\" card. Update your key or add Anthropic credits to restore service."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"Can I connect multiple Discord servers?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"Free and Starter plans support 1 Discord connection. Pro supports up to 5 connections, each pointing to a different Discord server with the same bot token or different tokens."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"Is there a free trial for paid plans?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"We don't offer a time-limited trial, but the Free tier is genuinely functional — all tools available, no expiration. Upgrade only when you want priority support, analytics, or multi-server support."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"How do I cancel?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"From your dashboard → Billing → Manage Subscription. This opens the Stripe Customer Portal where you can cancel immediately. Your plan downgrades to Free at the end of your billing period. No data is deleted for 30 days after downgrade."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"What if the bot disconnects?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"Daimon's health monitoring detects disconnections within 60 seconds and automatically attempts to reconnect using exponential backoff (up to 10 attempts over ~25 minutes). Your dashboard will show a \"Reconnecting…\" status. If reconnection fails, you'll see an error state with the specific error message from Discord."]]],["DIV",{"class":"faq-item"},["BUTTON",{"class":"faq-question-btn","aria-expanded":"false"},["SPAN",{"class":"faq-question-text"},"Do you offer team plans or enterprise?"],["SPAN",{"class":"faq-expand-icon","aria-hidden":"true"},"+"]],["DIV",{"class":"faq-answer","style":"max-height:0px"},["P",{"class":"faq-answer-inner"},"Pro supports up to 5 team members. For enterprise needs (more servers, custom SLAs, private deployments), contact us at hello@daimon.ai."]]]]]]],["SECTION",{"id":"final-cta","aria-label":"Get started"},["STYLE",{},"\n        .final-cta-root {\n          background-color: #0C1F40;\n          padding: 96px 0;\n          position: relative;\n          overflow: hidden;\n        }\n        .final-cta-blob {\n          position: absolute;\n          top: -100px;\n          right: -100px;\n          width: 500px;\n          height: 500px;\n          border-radius: 50%;\n          background-color: #B4E7DD;\n          opacity: 0.10;\n          filter: blur(100px);\n          pointer-events: none;\n        }\n        .final-cta-container {\n          position: relative;\n          z-index: 10;\n          max-width: 768px;\n          margin: 0 auto;\n          padding: 0 32px;\n          text-align: center;\n        }\n        .final-cta-heading {\n          font-size: clamp(32px, 4vw, 52px);\n          font-weight: 700;\n          color: #FFFFFF;\n          line-height: 1.1;\n          margin-bottom: 16px;\n        }\n        .final-cta-sub {\n          font-size: 20px;\n          font-weight: 400;\n          color: rgba(255, 255, 255, 0.65);\n          font-family: var(--font-body);\n          margin-bottom: 40px;\n        }\n        .final-cta-btn {\n          display: inline-flex;\n          align-items: center;\n          justify-content: center;\n          height: 44px;\n          padding: 0 36px;\n          background-color: #B4E7DD;\n          color: #0C1F40;\n          border: none;\n          border-radius: 0;\n          font-size: 15px;\n          font-weight: 600;\n          text-decoration: none;\n          transition: opacity 0.2s ease;\n          font-family: var(--font-body);\n          cursor: pointer;\n        }\n        .final-cta-btn:hover { opacity: 0.85; }\n        .final-cta-support {\n          font-size: 14px;\n          font-weight: 400;\n          color: rgba(255, 255, 255, 0.50);\n          font-family: var(--font-body);\n          margin-top: 16px;\n        }\n        .final-cta-support a {\n          color: #B4E7DD;\n          text-decoration: none;\n          transition: opacity 0.2s ease;\n        }\n        .final-cta-support a:hover { opacity: 0.8; }\n        @media (max-width: 900px) {\n          .final-cta-root { padding: 60px 0; }\n          .final-cta-heading { font-size: clamp(28px, 6vw, 40px); }\n          .final-cta-btn { width: 100%; }\n        }\n      "],["DIV",{"class":"final-cta-root"},["DIV",{"class":"final-cta-blob","aria-hidden":"true"}],["DIV",{"class":"final-cta-container"},["H2",{"class":"final-cta-heading font-headline-expanded"},"Get your AI Discord bot running today."],["P",{"class":"final-cta-sub"},"Free tier, no credit card, live in minutes."],["A",{"href":"/signup","class":"final-cta-btn"},"Create Your Free Account"],["P",{"class":"final-cta-support"},"Or read the docs first →"," ",["A",{"href":"/docs"},"View Quick Start"]]]]]],["FOOTER",{"style":"background-color:#0C1F40;padding:48px","class":"max-[900px]:!px-6 max-[900px]:!py-8"},["DIV",{"style":"display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr;gap:32px","class":"max-[900px]:!grid-cols-2 max-[900px]:!gap-x-6 max-[900px]:!gap-y-8"},["DIV",{"style":"display:flex;flex-direction:column","class":"max-[900px]:col-span-2"},["DIV",{"class":"flex items-center gap-2","style":"margin-bottom:12px"},["svg",{"width":"24","height":"24","viewBox":"0 0 32 32","fill":"none","xmlns":"http://www.w3.org/2000/svg","aria-hidden":"true"},["path",{"d":"M16 2L20 10H28L22 16L24 24L16 20L8 24L10 16L4 10H12L16 2Z","fill":"#B4E7DD"}]],["SPAN",{"style":"font-family:var(--font-archivo);font-size:18px;font-weight:700;color:#FFFFFF;font-variation-settings:'wdth' 112.5"},"Daimon"]],["P",{"style":"font-family:var(--font-inter);font-size:14px;font-weight:400;color:rgba(255,255,255,0.55);line-height:1.5;max-width:200px;margin:0"},"AI-powered Discord, on your terms."