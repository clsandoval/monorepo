{
  "rubricId": "auth-signup",
  "assertions": [
    { "id": "page",           "kind": "element_visible", "selector": "[data-testid=\"auth-page\"]" },
    { "id": "title",          "kind": "text_equals",     "selector": "[data-testid=\"auth-title\"]", "expect": "Create Account" },
    { "id": "submit",         "kind": "text_equals",     "selector": "[data-testid=\"auth-submit\"]", "expect": "Create Account" },
    { "id": "firm-field",     "kind": "element_visible", "selector": "#firmName" },
    { "id": "fullname-field", "kind": "element_visible", "selector": "#fullName" },
    { "id": "confirm-field",  "kind": "element_visible", "selector": "#confirmPassword" },
    { "id": "no-error",       "kind": "element_absent",  "selector": "[data-testid=\"auth-error\"]" },
    { "id": "clean-console",  "kind": "no_console_error" }
  ]
}
